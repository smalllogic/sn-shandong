<% input_class = "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
<div class="grid max-w-6xl gap-6 xl:grid-cols-[3fr_2fr]">
  <%= form_with model: [:admin, @field], class: "space-y-5 rounded-xl border border-slate-200 bg-white p-6" do |form| %>
    <% if @field.errors.any? %>
      <ul role="alert" class="list-disc rounded-lg bg-red-50 p-4 pl-8 text-sm text-red-800">
        <% @field.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    <% end %>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <%= form.label :code, "字段代码", class: "mb-1 block text-sm font-semibold" %>
        <%= form.text_field :code, required: true, readonly: @field.persisted?, maxlength: 48, placeholder: "capacity_l", class: input_class %>
        <p class="mt-1 text-xs text-slate-500">使用小写字母、数字和下划线。保存后固定。</p>
      </div>
      <div>
        <%= form.label :kind, "筛选方式", class: "mb-1 block text-sm font-semibold" %>
        <%= form.select :kind, CatalogFilterField::KINDS.invert.to_a, {}, class: input_class %>
      </div>
      <% { label_en: "英文名称（必填）", label_zh: "中文名称", label_it: "意大利语名称", label_fr: "法语名称" }.each do |attribute, label| %>
        <div>
          <%= form.label attribute, label, class: "mb-1 block text-sm font-semibold" %>
          <%= form.text_field attribute, required: attribute == :label_en, maxlength: 100, class: input_class %>
        </div>
      <% end %>
    </div>
    <div>
      <%= form.label :unit, "规格单位或价格货币", class: "mb-1 block text-sm font-semibold" %>
      <%= form.text_field :unit, maxlength: 20, placeholder: "L、°C 或 USD", class: input_class %>
      <p class="mt-1 text-xs text-slate-600">数值字段只匹配同单位或无单位的数值。无单位值按此单位解读，系统不会换算。价格必须填写货币。</p>
    </div>
    <div>
      <%= form.label :legacy_names, "商品中已有的规格名称", class: "mb-1 block text-sm font-semibold" %>
      <%= form.text_area :legacy_names, rows: 5, maxlength: 2500, placeholder: "Capacity\nVolume\n容积", class: input_class %>
      <p class="mt-1 text-xs text-slate-600">每行一个名称。把含义和单位相同的写法归到一起。价格字段直接读取 SKU 价格，此处留空。</p>
    </div>
    <div class="flex items-center gap-4">
      <%= form.submit "保存字段", class: "rounded-lg bg-primary px-4 py-2 font-semibold text-white" %>
      <%= link_to "返回", admin_catalog_filter_fields_path, class: "text-sm text-slate-600 hover:underline" %>
    </div>
  <% end %>
  <div class="self-start overflow-x-auto rounded-xl border border-slate-200 bg-white p-4">
    <h2 class="mb-3 font-semibold text-slate-900">已有商品规格示例</h2>
    <% if @examples.empty? %>
      <p class="text-sm text-slate-600">暂无规格样本。</p>
    <% else %>
      <table class="w-full text-left text-xs">
        <thead><tr><th class="p-2">名称</th><th class="p-2">示例值</th><th class="p-2">SKU 数</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% @examples.each do |example| %>
            <tr><td class="p-2 font-medium"><%= example["name"] %></td><td class="p-2 break-words"><%= truncate(example["example"], length: 65) %></td><td class="p-2"><%= example["quantity"] %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
