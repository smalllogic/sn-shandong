<% content_for :admin_title, @category.new_record? ? "创建分类" : "编辑分类" %>

<div class="max-w-2xl bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
  <%= form_with(model: [:admin, @category], local: true) do |f| %>
    <% if @category.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-lg text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% @category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= f.label :name, "英文名称 (English Name)", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.text_field :name, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="mb-6">
      <%= f.label :slug, "URL 别名 (Slug - 仅限小写字母、数字和连字符)", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.text_field :slug, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "这里严格遵循7大类产品的名称设计,其他名称无效" %>
    </div>


    <% if @category.parent %>
      <div class="mb-6">
        <span class="block text-sm font-medium text-slate-700 mb-2">所属频道 (Root Category)</span>
        <div class="px-4 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-600">
          <%= @category.category_kind %>
        </div>
        <%= f.hidden_field :category_kind %>
        <p class="mt-1 text-xs text-slate-500">子分类自动继承顶级分类的频道标识</p>
      </div>
    <% else %>
      <div class="mb-6">
        <span class="block text-sm font-medium text-slate-700 mb-2">频道属性 (Channel Concept)</span>
        <div class="p-4 bg-blue-50 border border-blue-100 rounded-lg">
          <p class="text-sm text-blue-800 font-medium mb-2">顶级分类即定义为一个频道</p>
          <p class="text-xs text-blue-600 mb-3">其 URL 别名 (Slug) 将自动作为该频道的唯一标识 (category_kind)，并应用到所有子分类。</p>
          <%= f.label :category_kind, "频道标识", class: "block text-xs font-medium text-slate-500 mb-1" %>
          <%= f.text_field :category_kind, class: "w-full px-4 py-2 border border-slate-300 rounded-lg bg-slate-100 cursor-not-allowed text-slate-500", readonly: true, placeholder: "保存后自动与 Slug 同步" %>
        </div>
      </div>
    <% end %>

    <% if @category.parent_id || !@category.new_record? %>
      <div class="mb-6">
        <%= f.label :parent_id, "父分类", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.collection_select :parent_id, Category.where.not(id: @category.id), :id, :name, { include_blank: "根分类" }, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    <% else %>
      <%= f.hidden_field :parent_id %>
    <% end %>

    <div class="mb-6">
      <%= f.label :position, "排序 (数字越小越靠前)", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.number_field :position, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "0" %>
    </div>

    <div class="mb-6 bg-slate-50 p-4 rounded-lg border border-slate-200">
      <div class="flex items-center mb-4">
        <%= f.check_box :featured, class: "w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500" %>
        <%= f.label :featured, "推荐到首页 (Featured on Home)", class: "ml-2 block text-sm font-bold text-slate-900" %>
      </div>

      <div class="mb-4">
        <%= f.label :featured_position, "首页推荐排序 (数字越小越靠前)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.number_field :featured_position, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "0" %>
      </div>

      <div class="mb-4">
        <%= f.label :keywords, "首页展示关键词 (例如: CUSTOM · OEM · ODM)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :keywords, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "CUSTOM · OEM · ODM" %>
        <p class="mt-1 text-xs text-slate-500">留空则显示默认的 CUSTOM · OEM · ODM</p>
      </div>

      <div class="mb-4">
        <%= f.label :image, "分类封面图 (首页显示用)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.file_field :image, class: "w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
        <% if @category.image.attached? && @category.image.persisted? %>
          <div class="mt-2">
            <% if @category.image.variable? %>
              <%= image_tag @category.image.variant(:thumb), class: "w-32 h-32 object-cover rounded-lg border" %>
            <% else %>
              <div class="w-32 h-32 bg-slate-100 rounded border flex items-center justify-center text-[10px] text-slate-500 text-center p-2">
                非图片格式 (<%= @category.image.content_type %>)
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div>
        <%= f.label :banner, "分类 Banner 图 (列表页顶部显示用)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.file_field :banner, class: "w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
        <% if @category.banner.attached? && @category.banner.persisted? %>
          <div class="mt-2">
            <% if @category.banner.variable? %>
              <%= image_tag @category.banner.variant(:large), class: "w-full h-32 object-cover rounded-lg border" %>
            <% else %>
              <div class="p-4 bg-slate-100 rounded text-xs text-slate-500">
                文件格式不可预览 (<%= @category.banner.content_type %>)
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%= render "admin/shared/seo_fields", f: f %>

    <div class="flex space-x-4">
      <%= f.submit "保存分类", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition-colors" %>
      <%= link_to "取消", admin_categories_path, class: "bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-2 rounded-lg font-medium transition-colors" %>
    </div>
  <% end %>
</div>
