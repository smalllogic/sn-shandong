<% content_for :admin_title, "后台概览" %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
  <%# Stat Card 1 %>
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 11m8 4v10M4 11v10l8 4"></path>
        </svg>
      </div>
      <span class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-full">库存储备</span>
    </div>
    <h3 class="text-slate-500 text-sm font-medium">产品总量</h3>
    <p class="text-2xl font-bold text-slate-800"><%= @total_skus %></p>
  </div>

  <%# Stat Card 2 %>
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full">正常运行</span>
    </div>
    <h3 class="text-slate-500 text-sm font-medium">在售产品</h3>
    <p class="text-2xl font-bold text-slate-800"><%= @active_skus %></p>
  </div>

  <%# Stat Card 3 %>
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
      </div>
      <span class="text-xs font-medium text-purple-600 bg-purple-50 px-2 py-1 rounded-full">系统管理</span>
    </div>
    <h3 class="text-slate-500 text-sm font-medium">注册用户</h3>
    <p class="text-2xl font-bold text-slate-800"><%= @users_count %></p>
  </div>

  <%# Stat Card 4 %>
  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
        </svg>
      </div>
      <span class="text-xs font-medium text-orange-600 bg-orange-50 px-2 py-1 rounded-full">需处理</span>
    </div>
    <h3 class="text-slate-500 text-sm font-medium">咨询消息</h3>
    <p class="text-2xl font-bold text-slate-800">
      <%= @messages_count %>
      <% if @unread_messages_count > 0 %>
        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
          <%= @unread_messages_count %> 未读
        </span>
      <% end %>
    </p>
  </div>

</div>

<div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
      <h3 class="font-bold text-slate-800">快速向导</h3>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 gap-4">
        <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
          <h4 class="font-semibold text-slate-700 mb-1 text-sm">欢迎使用管理系统</h4>
          <p class="text-xs text-slate-500">在这里，您可以管理您的产品线和监控用户活动。</p>
        </div>
        <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
          <h4 class="font-semibold text-slate-700 mb-1 text-sm">安全提示</h4>
          <p class="text-xs text-slate-500">请确保定期检查管理员权限分配，并保持系统处于最新状态。</p>
        </div>
      </div>
    </div>
  </div>

  <% if current_user.super_admin? %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-200">
        <h3 class="font-bold text-slate-800">分类与 SKU 导入导出</h3>
        <p class="mt-1 text-sm text-slate-500">导出一个 ZIP，包含全部分类和 SKU 数据；导入时先处理分类，再处理 SKU。</p>
      </div>
      <div class="p-6 space-y-5">
        <div>
          <%= link_to "导出分类和 SKU", admin_catalog_export_path,
            class: "inline-flex items-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" %>
        </div>
        <%= form_with url: admin_catalog_import_path, method: :post, multipart: true, local: true, class: "space-y-3" do |form| %>
          <%= form.label :file, "导入分类和 SKU ZIP", class: "block text-sm font-semibold text-slate-700" %>
          <%= form.file_field :file, accept: ".zip,application/zip", required: true,
            class: "block w-full rounded-lg border border-slate-300 p-2 text-sm text-slate-700" %>
          <p class="text-xs text-slate-500">仅接受本功能导出的 ZIP（最大 50 MB）。按分类 Slug、SKU 代码更新已有记录；任一错误都会回滚整包。分类图片、SKU 图片和富文本附件不包含在数据包中。</p>
          <%= form.submit "导入分类和 SKU", data: { turbo_confirm: "确定导入并更新同 Slug 分类与同代码 SKU 吗？" },
            class: "rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
