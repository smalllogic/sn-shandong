<% content_for :admin_title, "经销商管理" %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <div>
      <h2 class="text-xl font-black text-slate-800">经销商与申请审核</h2>
      <p class="text-sm text-slate-500 mt-1">管理经销商账号申请、审批状态及商户资料</p>
    </div>
    <div class="flex items-center space-x-2">
      <% [
        { key: 'all', label: '全部申请', count: User.dealers.count },
        { key: 'pending', label: '待审核', count: User.where(dealer_status: 'pending').count, badge_class: 'bg-amber-100 text-amber-800' },
        { key: 'approved', label: '已批准', count: User.where(dealer_status: 'approved').or(User.where(role: 'dealer')).count, badge_class: 'bg-emerald-100 text-emerald-800' },
        { key: 'rejected', label: '已拒绝', count: User.where(dealer_status: 'rejected').count, badge_class: 'bg-red-100 text-red-800' }
      ].each do |tab| %>
        <%= link_to admin_dealers_path(status: tab[:key]), class: "px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center space-x-1.5 #{@status == tab[:key] ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-50 hover:bg-slate-100 text-slate-600'}" do %>
          <span><%= tab[:label] %></span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= tab[:badge_class] || 'bg-slate-200 text-slate-700' %>">
            <%= tab[:count] %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-4 px-6">经销商 / 公司名称</th>
            <th class="py-4 px-6">联系人 & 电话</th>
            <th class="py-4 px-6">国家/地区</th>
            <th class="py-4 px-6">申请状态</th>
            <th class="py-4 px-6">申请时间</th>
            <th class="py-4 px-6 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @dealers.empty? %>
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                暂无相关经销商申请记录
              </td>
            </tr>
          <% else %>
            <% @dealers.each do |dealer| %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-4 px-6">
                  <div class="font-bold text-slate-900"><%= dealer.company_name.presence || "未填写公司名" %></div>
                  <div class="text-xs text-slate-500"><%= dealer.email %></div>
                </td>
                <td class="py-4 px-6">
                  <div class="font-medium text-slate-800"><%= dealer.contact_name.presence || "-" %></div>
                  <div class="text-xs text-slate-500"><%= dealer.phone.presence || "-" %></div>
                </td>
                <td class="py-4 px-6 text-slate-700 font-medium">
                  <%= dealer.country.presence || "-" %>
                </td>
                <td class="py-4 px-6">
                  <% if dealer.dealer_status == 'pending' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                      待审核
                    </span>
                  <% elsif dealer.dealer_approved? || dealer.role == 'dealer' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                      已批准
                    </span>
                  <% elsif dealer.dealer_status == 'rejected' %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
                      已拒绝
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600">
                      普通用户
                    </span>
                  <% end %>
                </td>
                <td class="py-4 px-6 text-slate-500 text-xs">
                  <%= dealer.created_at.strftime("%Y-%m-%d %H:%M") %>
                </td>
                <td class="py-4 px-6 text-right whitespace-nowrap space-x-2">
                  <%= link_to "详情", admin_dealer_path(dealer), class: "px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition-colors inline-block" %>
                  
                  <% if dealer.dealer_status == 'pending' || dealer.dealer_status == 'rejected' %>
                    <%= button_to approve_admin_dealer_path(dealer, status: @status), method: :patch, class: "px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg transition-colors inline-block", data: { turbo_confirm: "确定批准该用户的经销商身份申请吗？" } do %>
                      批准
                    <% end %>
                  <% end %>

                  <% if dealer.dealer_status == 'pending' || dealer.dealer_approved? %>
                    <%= button_to reject_admin_dealer_path(dealer, status: @status), method: :patch, class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 font-bold text-xs rounded-lg transition-colors inline-block", data: { turbo_confirm: "确定拒绝/撤回该经销商资格吗？" } do %>
                      拒绝
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if defined?(Kaminari) && @dealers.respond_to?(:total_pages) %>
      <div class="p-4 border-t border-slate-100">
        <%= paginate @dealers %>
      </div>
    <% end %>
  </div>
</div>
