<div class="max-w-2xl bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
  <%= form_with(model: [:admin, faq_category], local: true) do |f| %>
    <% if faq_category.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-lg text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% faq_category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div class="p-4 bg-blue-50 border border-blue-100 rounded-lg text-sm text-blue-800">
        请填写四种语言的分类名称。英文为必填项；其他译文留空时，前台会自动显示英文名称。
      </div>

      <% languages = [
        { label: "English", field: :name, required: true },
        { label: "中文", field: :name_zh, required: false },
        { label: "Italiano", field: :name_it, required: false },
        { label: "Français", field: :name_fr, required: false }
      ] %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <% languages.each do |language| %>
          <div>
            <%= f.label language[:field], "分类名称 (#{language[:label]})", class: "block text-sm font-semibold text-slate-700 mb-2" %>
            <%= f.text_field language[:field], required: language[:required], class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", placeholder: "输入#{language[:label]}分类名称..." %>
            <% unless language[:required] %>
              <p class="mt-1 text-xs text-slate-400">留空时回退英文</p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div>
        <%= f.label :position, "显示顺序", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.number_field :position, class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", placeholder: "数字越小越靠前" %>
      </div>

      <div class="flex items-center gap-4 pt-4 border-t border-slate-100">
        <%= f.submit faq_category.new_record? ? "创建分类" : "保存修改",
              class: "px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
        <%= link_to "取消", admin_faq_categories_path, class: "px-6 py-2.5 border border-slate-300 text-slate-600 hover:bg-slate-50 rounded-lg text-sm font-semibold transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
