<div class="max-w-4xl bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
  <%= form_with(model: [:admin, faq], local: true) do |f| %>
    <% if faq.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-lg text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% faq.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div class="p-4 bg-blue-50 border border-blue-100 rounded-lg text-sm text-blue-800">
        请填写四种语言的问题和答案。英文为必填项；其他译文留空时，前台会自动显示英文内容。
      </div>

      <div>
        <%= f.label :faq_category_id, "分类", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.collection_select :faq_category_id, FaqCategory.order(position: :asc), :id, :name, 
              { prompt: "选择分类..." }, 
              { class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900" } %>
      </div>

      <% languages = [
        { label: "English", code: "EN", question: :question, answer: :answer, required: true },
        { label: "中文", code: "中", question: :question_zh, answer: :answer_zh, required: false },
        { label: "Italiano", code: "IT", question: :question_it, answer: :answer_it, required: false },
        { label: "Français", code: "FR", question: :question_fr, answer: :answer_fr, required: false }
      ] %>

      <% languages.each do |language| %>
        <section class="p-5 border border-slate-200 rounded-xl bg-slate-50/50">
          <div class="flex items-center gap-3 mb-5 pb-3 border-b border-slate-200">
            <span class="inline-flex items-center justify-center min-w-9 h-7 px-2 rounded bg-blue-600 text-white text-xs font-bold"><%= language[:code] %></span>
            <h3 class="text-base font-bold text-slate-800"><%= language[:label] %> 内容</h3>
            <% if language[:required] %>
              <span class="text-xs font-medium text-red-500">必填</span>
            <% else %>
              <span class="text-xs text-slate-400">选填，留空回退英文</span>
            <% end %>
          </div>

          <div class="space-y-5">
            <div>
              <%= f.label language[:question], "问题 (#{language[:label]})", class: "block text-sm font-semibold text-slate-700 mb-2" %>
              <%= f.text_field language[:question], required: language[:required], class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", placeholder: "输入#{language[:label]}问题..." %>
            </div>

            <div>
              <%= f.label language[:answer], "答案 (#{language[:label]})", class: "block text-sm font-semibold text-slate-700 mb-2" %>
              <%= f.text_area language[:answer], rows: 6, required: language[:required], class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900 resize-none", placeholder: "输入#{language[:label]}答案..." %>
            </div>
          </div>
        </section>
      <% end %>

      <div>
        <%= f.label :position, "显示顺序", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.number_field :position, class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", placeholder: "数字越小越靠前" %>
      </div>

      <div class="flex items-center gap-4 pt-4 border-t border-slate-100">
        <%= f.submit faq.new_record? ? "创建问题" : "保存修改",
              class: "px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
        <%= link_to "取消", admin_faqs_path, class: "px-6 py-2.5 border border-slate-300 text-slate-600 hover:bg-slate-50 rounded-lg text-sm font-semibold transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
