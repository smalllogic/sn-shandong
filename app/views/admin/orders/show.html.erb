<div class="max-w-screen-xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-4">订单详情 #<%= @order.id %></h1>
  <div class="bg-white p-4 border mb-4">
    <p><strong>姓名:</strong> <%= @order.name %></p>
    <p><strong>邮箱:</strong> <%= @order.email %></p>
    <p><strong>国家:</strong> <%= @order.country %></p>
    <p><strong>电话:</strong> <%= @order.phone %></p>
    <p class="mt-2"><strong>状态:</strong> <%= @order.status.humanize %></p>
    <div class="mt-2 flex gap-2">
      <% Order.statuses.keys.each do |status| %>
        <% unless @order.status == status %>
          <%= button_to "标记为 #{status == 'replied' ? '已回复' : '待处理'}", admin_order_path(@order), method: :patch, params: { order: { status: status } }, class: "bg-blue-500 text-white px-3 py-1 rounded text-sm hover:bg-blue-600" %>
        <% end %>
      <% end %>
    </div>
  </div>
  <h2 class="text-xl font-bold mb-2">商品明细</h2>
  <table class="w-full bg-white border">
    <thead>
      <tr>
        <th class="border p-2">商品名称</th>
        <th class="border p-2">数量</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_items.each do |item| %>
        <tr>
          <td class="border p-2"><%= item.sku.name %></td>
          <td class="border p-2"><%= item.quantity %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= link_to '返回列表', admin_orders_path, class: "mt-4 inline-block bg-blue-500 text-white px-4 py-2" %>
</div>
