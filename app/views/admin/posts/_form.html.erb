<div class="max-w-5xl bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
  <%= form_with(model: [:admin, @post], local: true) do |f| %>
    <% if @post.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-lg text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% @post.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <div class="p-4 bg-blue-50 border border-blue-100 rounded-lg text-sm text-blue-800">
        请在同一篇文章中填写四种语言。英文标题为必填项；其他译文留空时，前台会自动显示英文内容。
      </div>

      <% languages = [
        { label: "English", code: "EN", title: :title, summary: :summary, content: :content, required: true },
        { label: "中文", code: "中", title: :title_zh, summary: :summary_zh, content: :content_zh, required: false },
        { label: "Italiano", code: "IT", title: :title_it, summary: :summary_it, content: :content_it, required: false },
        { label: "Français", code: "FR", title: :title_fr, summary: :summary_fr, content: :content_fr, required: false }
      ] %>

      <% languages.each do |language| %>
        <section class="p-5 border border-slate-200 rounded-xl bg-slate-50/50">
          <div class="flex items-center gap-3 mb-5 pb-3 border-b border-slate-200">
            <span class="inline-flex items-center justify-center min-w-9 h-7 px-2 rounded bg-blue-600 text-white text-xs font-bold"><%= language[:code] %></span>
            <h3 class="text-base font-bold text-slate-800"><%= language[:label] %> 内容</h3>
            <% if language[:required] %>
              <span class="text-xs font-medium text-red-500">标题必填</span>
            <% else %>
              <span class="text-xs text-slate-400">选填，留空回退英文</span>
            <% end %>
          </div>

          <div class="space-y-5">
            <div>
              <%= f.label language[:title], "文章标题 (#{language[:label]})", class: "block text-sm font-semibold text-slate-700 mb-2" %>
              <%= f.text_field language[:title], required: language[:required], class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", placeholder: "输入#{language[:label]}标题..." %>
            </div>

            <div>
              <%= f.label language[:summary], "简介 (#{language[:label]})", class: "block text-sm font-semibold text-slate-700 mb-2" %>
              <%= f.text_area language[:summary], rows: 3, class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900 resize-none", placeholder: "输入#{language[:label]}简介..." %>
            </div>

            <div>
              <%= f.label language[:content], "正文内容 (#{language[:label]})", class: "block text-sm font-semibold text-slate-700 mb-2" %>
              <div class="bg-white border border-slate-300 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500">
                <%= f.rich_text_area language[:content], class: "min-h-[300px]" %>
              </div>
            </div>
          </div>
        </section>
      <% end %>

      <div>
        <%= f.label :cover_image, "封面图片", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <% if @post.cover_image.attached? %>
          <div class="mb-3">
            <%= image_tag @post.cover_image, class: "h-32 w-auto rounded-lg object-cover border border-slate-200" %>
          </div>
        <% end %>
        <%= f.file_field :cover_image, accept: "image/*", class: "block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" %>
      </div>

      <div>
        <%= f.label :category, "分类", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.select :category, [["企业动态", "enterprise_updates"], ["行业新闻", "industry_news"]],
              { prompt: "请选择分类" },
              class: "w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", required: true %>
      </div>

      <div>
        <%= f.label :status, "状态", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.select :status, [["草稿", "draft"], ["已发布", "published"]],
              {},
              class: "w-48 px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900" %>
      </div>

      <div>
        <%= f.label :views_count, "浏览量", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.number_field :views_count, class: "w-48 px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-slate-900", min: 0 %>
        <p class="mt-1 text-xs text-slate-400 text-gray-400">设置文章的初始浏览量，用户每次访问文章详情页会自动累加。</p>
      </div>

      <%= render "admin/shared/seo_fields", f: f %>

      <div class="flex items-center gap-4 pt-4 border-t border-slate-100">
        <%= f.submit @post.new_record? ? "创建文章" : "保存修改",
              class: "px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
        <%= link_to "取消", admin_posts_path, class: "px-6 py-2.5 border border-slate-300 text-slate-600 hover:bg-slate-50 rounded-lg text-sm font-semibold transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
