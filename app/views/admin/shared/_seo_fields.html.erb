<div class="mt-8 mb-6 p-6 bg-slate-50 border border-slate-200 rounded-xl">
  <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center">
    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    SEO 设置 (TDK)
  </h3>
  
  <% ['en', 'zh', 'it', 'fr'].each do |lang| %>
    <% lang_label = { 'en' => 'English', 'zh' => '中文', 'it' => 'Italiano', 'fr' => 'Français' }[lang] %>
    <div class="mb-8 p-4 bg-white border border-slate-200 rounded-lg">
      <h4 class="text-sm font-bold text-blue-600 mb-3 border-b pb-2"><%= lang_label %> SEO 设置</h4>
      
      <div class="mb-4">
        <% field_name = lang == 'en' ? :meta_title : "meta_title_#{lang}" %>
        <%= f.label field_name, "Meta Title (标题) - #{lang_label}", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field field_name, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "如果不填，将使用默认标题" %>
      </div>

      <div class="mb-4">
        <% desc_name = lang == 'en' ? :meta_description : "meta_description_#{lang}" %>
        <%= f.label desc_name, "Meta Description (描述) - #{lang_label}", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area desc_name, rows: 2, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "如果不填，将使用默认描述" %>
      </div>

      <div class="mb-0">
        <% kw_name = lang == 'en' ? :meta_keywords : "meta_keywords_#{lang}" %>
        <%= f.label kw_name, "Meta Keywords (关键词) - #{lang_label}", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field kw_name, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "多个关键词用英文逗号隔开" %>
      </div>
    </div>
  <% end %>
</div>