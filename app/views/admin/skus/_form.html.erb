<% content_for :admin_title, @sku.new_record? ? "创建 SKU" : "编辑 SKU" %>

<div class="max-w-4xl bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
  <%= form_with(model: [:admin, @sku], local: true) do |f| %>
    <% if @sku.errors.any? %>
      <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-lg text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% @sku.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :name_en, "型号名称 (English)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :name_en, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :name_zh, "型号名称 (中文)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :name_zh, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :name_it, "型号名称 (Italian)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :name_it, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label :name_fr, "型号名称 (French)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :name_fr, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

      <div>
        <%= f.label :category_id, "所属分类 (必须是叶子分类)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.collection_select :category_id, Category.where.not(id: Category.where.not(parent_id: nil).select(:parent_id)).order(:category_kind, :name), :id, ->(cat) { "[ID:#{cat.id}] #{cat.localized_name}" }, { prompt: "请选择分类" }, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :price, "价格", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.number_field :price, step: 0.01, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :status, "状态", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.select :status, [['上架 (前台显示)', 'active'], ['草稿 (隐藏)', 'draft'], ['归档', 'archived']], { prompt: "请选择 SKU 状态" }, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <p class="mt-1 text-xs text-slate-500 italic">选择"草稿"时，该 SKU 不会在前台网站显示。</p>
      </div>

      <div>
        <%= f.label :position, "排序权重 (越大越靠前)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.number_field :position, class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <p class="mt-1 text-xs text-slate-500 italic">默认值为 0。前台展示时按此权重倒序排列（数字越大越靠前）。</p>
      </div>

      <div class="md:col-span-2">
        <%= f.label :images, "Product Images", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.file_field :images, multiple: true, accept: "image/*", class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", 
                        include_hidden: false %>
        <p class="mt-1 text-xs text-slate-500 italic">Uploading new images will append to existing ones. Hold Ctrl/Command to select multiple. JPEG, PNG, GIF, WebP, BMP only.</p>
        <p class="mt-1 text-xs text-blue-500">Note: Images will be processed by the server. For very large batches, please increase server timeout if needed.</p>
        
        <% if @sku.images.attached? %>
          <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-4">
            <% @sku.sorted_images.each do |image| %>
              <div class="relative group border border-slate-200 rounded-lg p-2 bg-slate-50">
                <div class="mb-2">
                  <% begin %>
                    <%= image_tag image.variant(:thumb), class: "w-full h-32 object-contain rounded bg-white" %>
                  <% rescue ArgumentError, ActiveStorage::InvariableError => e %>
                    <div class="w-full h-32 bg-red-50 rounded border border-red-200 flex items-center justify-center text-red-400 text-xs" title="File Error: <%= e.message %>">No Preview</div>
                  <% end %>
                </div>
                
                <div class="flex items-center gap-1.5">
                  <span class="text-xs text-slate-500 whitespace-nowrap">Sort:</span>
                  <%= number_field_tag "sku[image_positions][#{image.id}]", image.position, 
                                      class: "flex-grow min-w-[2.5rem] px-2 py-1 text-xs border border-slate-300 rounded focus:ring-blue-500 focus:border-blue-500" %>
                </div>

                <%= link_to delete_image_admin_sku_path(id: @sku.id, image_id: image.id), 
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                          class: "absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center shadow-lg hover:bg-red-600 transition-colors" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </div>
            <% end %>
          </div>
          <p class="mt-2 text-xs text-slate-500 italic">Lower values appear first. Click "Save SKU" to apply sort changes.</p>
        <% end %>
      </div>
    </div>

    <!-- specifications -->
    <div class="mb-6 bg-slate-50 p-6 rounded-xl border border-slate-200">
      <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-4">规格参数 (Specifications)</h3>
      <p class="text-xs text-slate-500 mb-4 italic">您可以为该 SKU 添加自定义参数，每行支持 4 种语言。</p>
      
      <div id="specifications-container" class="space-y-6">
        <% specs = @sku.specifications.is_a?(Array) ? @sku.specifications : [] %>
        <% specs.each_with_index do |spec, index| %>
          <% next unless spec.is_a?(Hash) %>
          <div class="p-4 bg-white border border-slate-200 rounded-lg spec-row relative">
            <button type="button" onclick="this.closest('.spec-row').remove()" class="absolute top-2 right-2 text-red-500 hover:text-red-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase">English</label>
                <div class="flex gap-2">
                  <input type="text" name="sku[specifications][][key]" value="<%= spec['key'] %>" placeholder="Key (e.g. Size)" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                  <input type="text" name="sku[specifications][][value]" value="<%= spec['value'] %>" placeholder="Value" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase">中文</label>
                <div class="flex gap-2">
                  <input type="text" name="sku[specifications][][key_zh]" value="<%= spec['key_zh'] %>" placeholder="键 (如: 尺寸)" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                  <input type="text" name="sku[specifications][][value_zh]" value="<%= spec['value_zh'] %>" placeholder="值" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase">Italiano</label>
                <div class="flex gap-2">
                  <input type="text" name="sku[specifications][][key_it]" value="<%= spec['key_it'] %>" placeholder="Chiave" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                  <input type="text" name="sku[specifications][][value_it]" value="<%= spec['value_it'] %>" placeholder="Valore" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
                </div>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase">Français</label>
                <div class="flex gap-2">
                  <input type="text" name="sku[specifications][][key_fr]" value="<%= spec['key_fr'] %>" placeholder="Clé" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                  <input type="text" name="sku[specifications][][value_fr]" value="<%= spec['value_fr'] %>" placeholder="Valeur" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <button type="button" id="add-spec-btn" class="mt-4 inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
        </svg>
        添加规格参数
      </button>
    </div>

    <!-- standard_features -->
    <div class="mb-6 space-y-6">
      <div>
        <%= f.label :standard_features, "主要特点 (Standard Features - English)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.rich_text_area :standard_features, class: "min-h-[150px] border border-slate-300 rounded-lg" %>
      </div>
      <div>
        <%= f.label :standard_features_zh, "主要特点 (中文)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.rich_text_area :standard_features_zh, class: "min-h-[150px] border border-slate-300 rounded-lg" %>
      </div>
      <div>
        <%= f.label :standard_features_it, "主要特点 (Italiano)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.rich_text_area :standard_features_it, class: "min-h-[150px] border border-slate-300 rounded-lg" %>
      </div>
      <div>
        <%= f.label :standard_features_fr, "主要特点 (Français)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.rich_text_area :standard_features_fr, class: "min-h-[150px] border border-slate-300 rounded-lg" %>
      </div>
    </div>

    <%= render "admin/shared/seo_fields", f: f %>

    <div class="flex space-x-4">
      <%= f.submit "保存 SKU", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium transition-colors" %>
      <%= link_to "取消", admin_skus_path, class: "bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-2 rounded-lg font-medium transition-colors" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const addBtn = document.getElementById('add-spec-btn');
    const container = document.getElementById('specifications-container');
    
    if (addBtn && container) {
      addBtn.addEventListener('click', function() {
        const row = document.createElement('div');
        row.className = 'p-4 bg-white border border-slate-200 rounded-lg spec-row relative';
        row.innerHTML = `
          <button type="button" onclick="this.closest('.spec-row').remove()" class="absolute top-2 right-2 text-red-500 hover:text-red-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase">English</label>
              <div class="flex gap-2">
                <input type="text" name="sku[specifications][][key]" placeholder="Key (e.g. Size)" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                <input type="text" name="sku[specifications][][value]" placeholder="Value" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase">中文</label>
              <div class="flex gap-2">
                <input type="text" name="sku[specifications][][key_zh]" placeholder="键 (如: 尺寸)" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                <input type="text" name="sku[specifications][][value_zh]" placeholder="值" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase">Italiano</label>
              <div class="flex gap-2">
                <input type="text" name="sku[specifications][][key_it]" placeholder="Chiave" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                <input type="text" name="sku[specifications][][value_it]" placeholder="Valore" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-400 uppercase">Français</label>
              <div class="flex gap-2">
                <input type="text" name="sku[specifications][][key_fr]" placeholder="Clé" class="w-1/3 px-2 py-1 text-xs border border-slate-300 rounded">
                <input type="text" name="sku[specifications][][value_fr]" placeholder="Valeur" class="w-2/3 px-2 py-1 text-xs border border-slate-300 rounded">
              </div>
            </div>
          </div>
        `;
        container.appendChild(row);
      });
    }
  });
</script>
