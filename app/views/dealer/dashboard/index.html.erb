<% content_for :dealer_title, "工作台概览" %>

<div class="space-y-6">
  <!-- Status Alert / Banner -->
  <% if current_user.dealer_pending? %>
    <div class="p-6 bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border-l-4 border-amber-500 rounded-2xl bg-white shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h3 class="font-black text-amber-900 text-lg flex items-center">
          <svg class="w-5 h-5 mr-2 text-amber-600 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          您的经销商申请正在审核中
        </h3>
        <p class="text-xs text-amber-800/80 mt-1">
          我们的管理团队正在核实您的企业信息，审核通过后您将获得更多专属权限与价格支持。您当前已可以正常提交并管理您的询盘和订单。
        </p>
      </div>
      <%= link_to "完善企业资料", dealer_profile_path, class: "px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl transition-colors whitespace-nowrap shadow-sm" %>
    </div>
  <% elsif current_user.dealer_approved? || current_user.dealer? %>
    <div class="p-6 bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-transparent border-l-4 border-emerald-500 rounded-2xl bg-white shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h3 class="font-black text-emerald-900 text-lg flex items-center">
          <svg class="w-5 h-5 mr-2 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          已认证经销商合作商户
        </h3>
        <p class="text-xs text-emerald-800/80 mt-1">
          尊贵的 <%= current_user.company_name.presence || current_user.display_name %>，欢迎访问 Sinower 经销商专属中心。
        </p>
      </div>
      <div class="flex items-center space-x-2">
        <%= link_to "提交新询盘", contact_path, class: "px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition-colors shadow-sm" %>
        <%= link_to "浏览产品中心", products_path, class: "px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition-colors shadow-sm" %>
      </div>
    </div>
  <% end %>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">累计提交询盘</span>
        <span class="text-3xl font-black text-slate-900 mt-2 block"><%= @inquiries_count %></span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">累计提交订单</span>
        <span class="text-3xl font-black text-slate-900 mt-2 block"><%= @orders_count %></span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">认证企业</span>
        <span class="text-sm font-bold text-slate-800 mt-2 block truncate max-w-[150px]"><%= current_user.company_name.presence || "未完善" %></span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">联系电话</span>
        <span class="text-sm font-bold text-slate-800 mt-2 block truncate max-w-[150px]"><%= current_user.phone.presence || "未设置" %></span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      </div>
    </div>
  </div>

  <!-- Recent Inquiries & Orders -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Inquiries Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-black text-slate-900 flex items-center text-base">
          <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          最近提交的询盘
        </h3>
        <%= link_to "查看全部询盘 →", dealer_inquiries_path, class: "text-xs font-bold text-primary hover:underline" %>
      </div>

      <div class="divide-y divide-slate-100">
        <% if @recent_inquiries.empty? %>
          <div class="p-10 text-center">
            <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <p class="text-xs text-slate-400">暂无询盘记录</p>
            <%= link_to "立即提交询盘", contact_path, class: "mt-3 inline-block px-4 py-2 bg-primary text-white text-xs font-bold rounded-xl shadow-sm hover:bg-slate-900 transition-colors" %>
          </div>
        <% else %>
          <% @recent_inquiries.each do |msg| %>
            <div class="p-5 hover:bg-slate-50 transition-colors">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                <span class="font-medium text-slate-500"><%= msg.name %> (<%= msg.email %>)</span>
                <span><%= msg.created_at.strftime("%Y-%m-%d %H:%M") %></span>
              </div>
              <p class="text-sm font-medium text-slate-800 line-clamp-2"><%= msg.message %></p>
              <div class="mt-2 text-right">
                <%= link_to "查看详情 →", dealer_inquiry_path(msg), class: "text-xs font-bold text-primary hover:underline" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Orders Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-black text-slate-900 flex items-center text-base">
          <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          最近提交的订单
        </h3>
        <%= link_to "查看全部订单 →", dealer_orders_path, class: "text-xs font-bold text-primary hover:underline" %>
      </div>

      <div class="divide-y divide-slate-100">
        <% if @recent_orders.empty? %>
          <div class="p-10 text-center">
            <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            <p class="text-xs text-slate-400">暂无订单记录</p>
            <%= link_to "浏览商城下单", products_path, class: "mt-3 inline-block px-4 py-2 bg-slate-900 text-white text-xs font-bold rounded-xl shadow-sm hover:bg-primary transition-colors" %>
          </div>
        <% else %>
          <% @recent_orders.each do |order| %>
            <div class="p-5 hover:bg-slate-50 transition-colors">
              <div class="flex items-center justify-between text-xs mb-1.5">
                <span class="font-bold text-slate-900">订单 #<%= order.id %></span>
                <span class="text-slate-400"><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></span>
              </div>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span>包含 <%= order.order_items.count %> 项设备型号</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= order.pending? ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
                  <%= order.status == 'pending' ? '待处理' : '已回复' %>
                </span>
              </div>
              <div class="mt-2 text-right">
                <%= link_to "查看订单详情 →", dealer_order_path(order), class: "text-xs font-bold text-primary hover:underline" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
