<% content_for :dealer_title, "我的询盘记录" %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <div>
      <h2 class="text-xl font-black text-slate-900">询盘与留言列表</h2>
      <p class="text-xs text-slate-500 mt-1">查看您在 Sinower 提交的所有产品询盘与工厂业务咨询</p>
    </div>
    <%= link_to contact_path, class: "px-4 py-2.5 bg-primary hover:bg-slate-900 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center space-x-1.5" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>提交新询盘</span>
    <% end %>
  </div>

  <!-- Inquiries Table -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-4 px-6">询盘内容</th>
            <th class="py-4 px-6">联系人 / 邮箱</th>
            <th class="py-4 px-6">提交时间</th>
            <th class="py-4 px-6 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @inquiries.empty? %>
            <tr>
              <td colspan="4" class="py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                <div class="text-sm font-bold text-slate-700">暂无已提交的询盘</div>
                <p class="text-xs text-slate-400 mt-1">您可以通过联系页面或产品页面向工厂发送询盘</p>
                <%= link_to "立即发送询盘", contact_path, class: "mt-4 inline-block px-5 py-2.5 bg-primary text-white text-xs font-bold rounded-xl shadow-md hover:bg-slate-900 transition-colors" %>
              </td>
            </tr>
          <% else %>
            <% @inquiries.each do |inquiry| %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-4 px-6">
                  <p class="font-bold text-slate-900 line-clamp-2"><%= inquiry.message %></p>
                </td>
                <td class="py-4 px-6 whitespace-nowrap">
                  <div class="font-medium text-slate-800"><%= inquiry.name %></div>
                  <div class="text-xs text-slate-400"><%= inquiry.email %></div>
                </td>
                <td class="py-4 px-6 text-slate-500 text-xs whitespace-nowrap">
                  <%= inquiry.created_at.strftime("%Y-%m-%d %H:%M") %>
                </td>
                <td class="py-4 px-6 text-right whitespace-nowrap">
                  <%= link_to "查看详情", dealer_inquiry_path(inquiry), class: "px-3.5 py-1.5 bg-slate-100 hover:bg-primary hover:text-white text-slate-700 font-bold text-xs rounded-lg transition-all inline-block" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if defined?(Kaminari) && @inquiries.respond_to?(:total_pages) %>
      <div class="p-4 border-t border-slate-100">
        <%= paginate @inquiries %>
      </div>
    <% end %>
  </div>
</div>
