<% content_for :dealer_title, "我的订单记录" %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <div>
      <h2 class="text-xl font-black text-slate-900">采购订单记录</h2>
      <p class="text-xs text-slate-500 mt-1">查看您提交的所有设备意向采购订单及产品清单</p>
    </div>
    <%= link_to products_path, class: "px-4 py-2.5 bg-slate-900 hover:bg-primary text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center space-x-1.5" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <span>浏览商城设备</span>
    <% end %>
  </div>

  <!-- Orders Table -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-4 px-6">订单号</th>
            <th class="py-4 px-6">产品清单</th>
            <th class="py-4 px-6">联系信息</th>
            <th class="py-4 px-6">订单状态</th>
            <th class="py-4 px-6">下单时间</th>
            <th class="py-4 px-6 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @orders.empty? %>
            <tr>
              <td colspan="6" class="py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                <div class="text-sm font-bold text-slate-700">暂无已提交的订单</div>
                <p class="text-xs text-slate-400 mt-1">您可以在产品中心将心仪设备加入清单并提交采购订单</p>
                <%= link_to "浏览产品中心", products_path, class: "mt-4 inline-block px-5 py-2.5 bg-slate-900 text-white text-xs font-bold rounded-xl shadow-md hover:bg-primary transition-colors" %>
              </td>
            </tr>
          <% else %>
            <% @orders.each do |order| %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-4 px-6 font-bold text-slate-900 whitespace-nowrap">
                  #<%= order.id %>
                </td>
                <td class="py-4 px-6">
                  <div class="font-medium text-slate-800">
                    <%= order.order_items.count %> 项设备型号
                  </div>
                  <div class="text-xs text-slate-400 truncate max-w-xs">
                    <%= order.order_items.map { |i| "#{i.sku&.name || 'SKU'} x #{i.quantity}" }.join(', ') %>
                  </div>
                </td>
                <td class="py-4 px-6 whitespace-nowrap text-xs text-slate-600">
                  <div class="font-bold text-slate-800"><%= order.name %></div>
                  <div><%= order.phone %></div>
                  <div class="text-slate-400"><%= order.country %></div>
                </td>
                <td class="py-4 px-6 whitespace-nowrap">
                  <% if order.pending? %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                      待工厂处理
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                      已回复
                    </span>
                  <% end %>
                </td>
                <td class="py-4 px-6 text-slate-500 text-xs whitespace-nowrap">
                  <%= order.created_at.strftime("%Y-%m-%d %H:%M") %>
                </td>
                <td class="py-4 px-6 text-right whitespace-nowrap">
                  <%= link_to "查看详情", dealer_order_path(order), class: "px-3.5 py-1.5 bg-slate-100 hover:bg-primary hover:text-white text-slate-700 font-bold text-xs rounded-lg transition-all inline-block" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if defined?(Kaminari) && @orders.respond_to?(:total_pages) %>
      <div class="p-4 border-t border-slate-100">
        <%= paginate @orders %>
      </div>
    <% end %>
  </div>
</div>
