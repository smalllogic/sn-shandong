<% content_for :dealer_title, "订单详情" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <%= link_to dealer_orders_path, class: "inline-flex items-center text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      返回订单列表
    <% end %>

    <span class="text-xs text-slate-400">
      下单时间: <%= @order.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
    </span>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-6 md:p-8 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-primary block mb-1">采购意向单</span>
        <h2 class="text-2xl font-black text-slate-900">订单号 #<%= @order.id %></h2>
      </div>
      <div>
        <% if @order.pending? %>
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
            <span class="w-2 h-2 rounded-full bg-amber-500 mr-2"></span>
            待工厂审核与报价
          </span>
        <% else %>
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span>
            已回复
          </span>
        <% end %>
      </div>
    </div>

    <!-- Contact & Details Grid -->
    <div class="p-6 md:p-8 border-b border-slate-100 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <div>
        <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">联系人姓名</span>
        <span class="text-sm font-bold text-slate-800"><%= @order.name %></span>
      </div>
      <div>
        <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">电子邮箱</span>
        <span class="text-sm font-bold text-slate-800"><%= @order.email %></span>
      </div>
      <div>
        <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">联系电话</span>
        <span class="text-sm font-bold text-slate-800"><%= @order.phone %></span>
      </div>
      <div>
        <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">目的国家 / 地区</span>
        <span class="text-sm font-bold text-slate-800"><%= @order.country %></span>
      </div>
    </div>

    <% if @order.message.present? %>
      <div class="p-6 md:p-8 border-b border-slate-100 bg-slate-50/30">
        <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">订单附言 / 特殊需求</span>
        <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @order.message %></p>
      </div>
    <% end %>

    <!-- Order Items Table -->
    <div class="p-6 md:p-8">
      <h3 class="font-black text-slate-900 mb-4 text-base">订购设备清单</h3>
      <div class="rounded-xl border border-slate-200 overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
              <th class="py-3 px-4">产品型号</th>
              <th class="py-3 px-4">产品编码</th>
              <th class="py-3 px-4 text-right">订购数量</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            <% @order.order_items.each do |item| %>
              <tr class="hover:bg-slate-50/50">
                <td class="py-3 px-4 font-bold text-slate-900">
                  <% if item.sku %>
                    <%= link_to item.sku.name, sku_path(item.sku), class: "hover:text-primary transition-colors", target: "_blank" %>
                  <% else %>
                    未知产品型号
                  <% end %>
                </td>
                <td class="py-3 px-4 text-slate-500 text-xs font-mono">
                  <%= item.sku&.sku_code || "-" %>
                </td>
                <td class="py-3 px-4 text-right font-black text-slate-900">
                  <%= item.quantity %> 台/套
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
