<% content_for :dealer_title, "编辑企业资料" %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <%= link_to dealer_profile_path, class: "inline-flex items-center text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      返回企业资料
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
    <h2 class="text-xl font-black text-slate-900 mb-6">修改企业资料及安全密码</h2>

    <%= form_with model: @user, url: dealer_profile_path, method: :patch, class: "space-y-5" do |f| %>
      <% if @user.errors.any? %>
        <div class="p-4 bg-red-50 text-red-700 rounded-xl text-sm mb-4">
          <%= @user.errors.full_messages.join(', ') %>
        </div>
      <% end %>

      <div>
        <%= f.label :company_name, "公司名称 / 企业名称", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.text_field :company_name, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :contact_name, "联系人姓名", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :contact_name, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent" %>
        </div>
        <div>
          <%= f.label :phone, "联系电话 / WhatsApp", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :phone, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent" %>
        </div>
      </div>

      <div>
        <%= f.label :country, "国家 / 地区", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.text_field :country, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :dealer_notes, "主营业务 / 需求说明", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.text_area :dealer_notes, rows: 3, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent" %>
      </div>

      <div class="pt-6 border-t border-slate-100">
        <h3 class="text-sm font-bold text-slate-900 mb-1">修改登录密码</h3>
        <p class="text-xs text-slate-500 mb-4">若无需修改密码，请留空以下字段</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :password, "新密码", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "留空表示不修改" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "确认新密码", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "再次输入新密码" %>
          </div>
        </div>
      </div>

      <div class="pt-4 flex items-center justify-end space-x-3">
        <%= link_to "取消", dealer_profile_path, class: "px-5 py-2.5 border border-slate-200 text-slate-600 font-bold text-xs rounded-xl hover:bg-slate-50 transition-colors" %>
        <%= f.submit "保存更改", class: "px-6 py-2.5 bg-slate-900 hover:bg-primary text-white font-bold text-xs rounded-xl shadow-md transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
