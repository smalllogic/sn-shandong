<div class="min-h-screen flex flex-col items-center justify-center bg-slate-50 py-12 px-4 sm:px-6 lg:px-8" x-data="{ isDealer: <%= params[:dealer] == '1' ? 'true' : 'false' %> }">
  <div class="max-w-lg w-full space-y-8 bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
    <div class="text-center">
      <%= link_to root_path, class: "inline-block mb-3" do %>
        <%= image_tag "logo.png", class: "h-9 w-auto mx-auto" %>
      <% end %>
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        注册 Sinower 账号
      </h2>
      <p class="mt-2 text-xs text-slate-500">
        创建账号以管理您的询盘、订单及商务合作
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Basic Account Info -->
      <div class="space-y-4">
        <div>
          <%= f.label :email, "电子邮箱 *", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all", placeholder: "your-email@example.com" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :password, "设置密码 *", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.password_field :password, autocomplete: "new-password", required: true, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all", placeholder: "#{@minimum_password_length} 位以上" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "确认密码 *", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all", placeholder: "再次输入密码" %>
          </div>
        </div>
      </div>

      <!-- Dealer Application Toggle Section -->
      <div class="pt-4 border-t border-slate-100">
        <label class="flex items-start p-4 bg-amber-50/70 border border-amber-200/80 rounded-2xl cursor-pointer hover:bg-amber-50 transition-colors">
          <input type="checkbox" name="user[apply_dealer]" value="1" x-model="isDealer" class="mt-0.5 h-4 w-4 text-amber-600 focus:ring-amber-500 border-slate-300 rounded">
          <div class="ml-3">
            <span class="block text-sm font-bold text-amber-900">申请成为“经销商”合作伙伴</span>
            <span class="block text-xs text-amber-700/90 mt-0.5">申请后由管理员后台审批。通过后可解锁大经销商独立后台，尊享专属订单和询盘跟踪。</span>
          </div>
        </label>
      </div>

      <!-- Dealer Extra Fields (Collapsible) -->
      <div x-show="isDealer" x-collapse x-cloak class="space-y-4 pt-2">
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-4">
          <div class="text-xs font-bold text-slate-700 uppercase tracking-wider border-b border-slate-200 pb-2">
            经销商认证信息
          </div>
          
          <div>
            <%= f.label :company_name, "公司名称 / 企业名称", class: "block text-xs font-bold text-slate-600 mb-1" %>
            <%= f.text_field :company_name, class: "w-full px-3.5 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "例如：ABC Kitchen Equipment Co." %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <%= f.label :contact_name, "联系人姓名", class: "block text-xs font-bold text-slate-600 mb-1" %>
              <%= f.text_field :contact_name, class: "w-full px-3.5 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "姓名" %>
            </div>
            <div>
              <%= f.label :phone, "联系电话 / WhatsApp", class: "block text-xs font-bold text-slate-600 mb-1" %>
              <%= f.text_field :phone, class: "w-full px-3.5 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "+86 13800000000" %>
            </div>
          </div>

          <div>
            <%= f.label :country, "所在国家 / 地区", class: "block text-xs font-bold text-slate-600 mb-1" %>
            <%= f.text_field :country, class: "w-full px-3.5 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "例如：China, France, USA, Italy 等" %>
          </div>

          <div>
            <%= f.label :dealer_notes, "申请说明 / 主营业务", class: "block text-xs font-bold text-slate-600 mb-1" %>
            <%= f.text_area :dealer_notes, rows: 2, class: "w-full px-3.5 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-transparent", placeholder: "简单介绍您的公司业务或采购需求..." %>
          </div>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "立即注册", class: "w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-slate-900 hover:bg-primary transition-all shadow-lg hover:shadow-primary/20 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        已有账号？
        <%= link_to "直接登录", new_user_session_path, class: "font-bold text-primary hover:underline ml-1" %>
      </p>
    </div>
  </div>
</div>
