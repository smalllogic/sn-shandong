<div class="min-h-screen flex flex-col items-center justify-center bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
    <div class="text-center">
      <%= link_to root_path, class: "inline-block mb-3" do %>
        <%= image_tag "logo.png", class: "h-9 w-auto mx-auto" %>
      <% end %>
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        登录 Sinower
      </h2>
      <p class="mt-2 text-xs text-slate-500">
        登录账号以访问管理员后台或经销商独立中心
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, "电子邮箱", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all", placeholder: "your-email@example.com" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <%= f.label :password, "登录密码", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider" %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full px-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all", placeholder: "输入密码" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center text-xs font-medium text-slate-600 cursor-pointer">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-primary focus:ring-primary border-slate-300 rounded" %>
            <span class="ml-2">记住登录状态</span>
          </label>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit "登录", class: "w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-slate-900 hover:bg-primary transition-all shadow-lg hover:shadow-primary/20 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        还没有账号？
        <%= link_to "立即注册 / 申请成为经销商", new_user_registration_path, class: "font-bold text-primary hover:underline ml-1" %>
      </p>
    </div>
  </div>
</div>
