<style>
.global-presence-section {
    background: radial-gradient(circle at center, #123047, #020617);
    color: white;
    padding: 80px 20px;
    overflow: hidden;
}

.global-presence-section .map-container {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: auto;
}

.global-presence-section .world-map {
    width: 100%;
    height: auto;
    opacity: .4;
    display: block;
}

.global-presence-section .connections {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
}

.global-presence-section .connection-line {
    fill: none;
    stroke: #22c55e;
    stroke-width: 1.5;
    stroke-dasharray: 8 8;
    animation: global-flow 3s linear infinite;
    opacity: .6;
}

@keyframes global-flow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -32; }
}

.global-presence-section .map-point {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 10;
}

.global-presence-section .map-point span {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #f97316;
    border: 2px solid white;
    animation: global-pulse 2s infinite;
}

@keyframes global-pulse {
    0% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.8); }
    70% { box-shadow: 0 0 0 15px rgba(249, 115, 22, 0); }
    100% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0); }
}

.global-presence-section .china span {
    width: 20px;
    height: 20px;
    background: #22c55e;
    box-shadow: 0 0 15px #22c55e, 0 0 30px rgba(34, 197, 94, .7);
}

.global-presence-section .card {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    padding: 15px;
    background: rgba(255, 255, 255, 0.98);
    color: #111827;
    border-radius: 12px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    z-index: 20;
}

.global-presence-section .map-point:hover .card {
    opacity: 1;
    bottom: 40px;
}

.global-presence-section .card h3 {
    margin: 0 0 8px 0;
    color: #047857;
    font-size: 16px;
    font-weight: 700;
}

.global-presence-section .card p {
    font-size: 12px;
    margin: 4px 0;
    line-height: 1.4;
    color: #4b5563;
}
.global-presence-section .china { left: 78%; top: 35%; }
.global-presence-section .usa { left: 20%; top: 34%; }
.global-presence-section .germany { left: 51%; top: 20%; }
.global-presence-section .france { left: 49%; top: 25%; }
.global-presence-section .czech { left: 55%; top: 24%; }
.global-presence-section .uae { left: 65%; top: 41%; }

@media (max-width: 768px) {
    .global-presence-section .card {
        width: 180px;
        padding: 10px;
    }
    .global-presence-section .title h2 { font-size: 32px; }
}
</style>

<section class="global-presence-section">
    <div class="max-w-screen-xl mx-auto">
        <div class="text-center mb-16 px-4">
            <h2 class="text-4xl md:text-5xl font-black mb-6 text-white tracking-tight">Global Presence</h2>
            <p class="text-slate-400 text-lg max-w-2xl mx-auto">
                Founded in 2002, China Headquarters connecting worldwide offices and service networks, delivering excellence to over 180 countries.
            </p>
        </div>

        <div class="map-container" id="global-map-container">
            <%= image_tag "world.svg", class: "world-map", alt: "World Map" %>
            
            <svg class="connections" id="global-connections-svg"></svg>

            <!-- China -->
            <div class="map-point china" data-name="china">
                <span></span>
                <div class="card">
                    <h3>China Headquarters</h3>
                    <p><strong>Sinower Electrical</strong></p>
                    <p>Shandong Binzhou, China</p>
                    <p>140,000㎡ Factory</p>
                </div>
            </div>

            <!-- USA -->
            <div class="map-point usa" data-name="usa">
                <span></span>
                <div class="card">
                    <h3>USA Subsidiary</h3>
                    <p><strong>Skyrainbow USA</strong></p>
                    <p>Norcross, Georgia</p>
                </div>
            </div>

            <!-- Germany -->
            <div class="map-point germany" data-name="germany">
                <span></span>
                <div class="card">
                    <h3>Germany Branch</h3>
                    <p>European Office</p>
                    <p>Munich, Germany</p>
                </div>
            </div>

            <!-- France -->
            <div class="map-point france" data-name="france">
                <span></span>
                <div class="card">
                    <h3>France Branch</h3>
                    <p>European Service Center</p>
                    <p>Paris, France</p>
                </div>
            </div>


            <div class="map-point czech" data-name="czech">
                <span></span>
                <div class="card">
                    <h3><%= t('home.branches.czech') %></h3>
                    <p>European Logistics Hub</p>
                    <p>Czech Republic</p>
                </div>
            </div>

            <!-- UAE -->
            <div class="map-point uae" data-name="uae">
                <span></span>
                <div class="card">
                    <h3>UAE Branch</h3>
                    <p>Sharjah, UAE</p>
                </div>
            </div>
        </div>

        <div class="flex justify-center gap-8 mt-12 text-sm font-bold uppercase tracking-widest">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[#22c55e]"></span>
                <span class="text-[#22c55e]">China Headquarters</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[#f97316]"></span>
                <span class="text-[#f97316]">Global Offices</span>
            </div>
        </div>
    </div>
</section>

<script>
(function() {
    function drawGlobalConnections() {
        const container = document.getElementById("global-map-container");
        const svg = document.getElementById("global-connections-svg");
        const chinaPoint = document.querySelector(".global-presence-section .china span");
        
        if (!container || !svg || !chinaPoint) return;

        svg.innerHTML = "";
        const containerRect = container.getBoundingClientRect();
        const chinaRect = chinaPoint.getBoundingClientRect();

        const sx = chinaRect.left + chinaRect.width / 2 - containerRect.left;
        const sy = chinaRect.top + chinaRect.height / 2 - containerRect.top;

        document.querySelectorAll(".global-presence-section .map-point:not(.china) span").forEach(point => {
            const pointRect = point.getBoundingClientRect();
            const ex = pointRect.left + pointRect.width / 2 - containerRect.left;
            const ey = pointRect.top + pointRect.height / 2 - containerRect.top;

            const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
            
            // Calculate a curve
            const dx = ex - sx;
            const dy = ey - sy;
            const dr = Math.sqrt(dx * dx + dy * dy);
            
            // Using a quadratic curve with a control point pulled upwards
            // The height of the curve depends on the distance
            const cx = (sx + ex) / 2;
            const cy = Math.min(sy, ey) - (dr * 0.15); // Adjust multiplier for curve height

            path.setAttribute("d", `M ${sx} ${sy} Q ${cx} ${cy} ${ex} ${ey}`);
            path.classList.add("connection-line");
            svg.appendChild(path);
        });
    }

    // Run on load and resize
    window.addEventListener("load", drawGlobalConnections);
    window.addEventListener("resize", drawGlobalConnections);
    
    // Turbo compatibility
    document.addEventListener("turbo:load", drawGlobalConnections);
    document.addEventListener("turbo:render", drawGlobalConnections);
    
    // Also handle possible lazy loading or timing issues
    let resizeObserver = new ResizeObserver(() => {
        drawGlobalConnections();
    });
    
    document.addEventListener("turbo:load", () => {
        const container = document.getElementById("global-map-container");
        if (container) resizeObserver.observe(container);
        drawGlobalConnections();
    }, { once: false });

    // Initial draw in case it's already loaded
    setTimeout(drawGlobalConnections, 100);
})();
</script>
