<% content_for :title, t('seo.products.title') %>
<% content_for :meta_description, t('seo.products.description') %>

<div class="bg-slate-50 min-h-screen pb-20">
  <!-- Header Section -->
  <div class="bg-dark py-16 mb-12">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
            <%= t('categories.all_products_catalog') %>
          </h1>
          <p class="text-slate-400 text-lg font-medium max-w-2xl">
            <%= t('categories.all_products_desc') %>
          </p>
        </div>
        <div class="hidden md:block">
          <div class="text-right">
            <div class="text-3xl font-black text-primary mb-1"><%= Sku.visible.count %></div>
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest text-nowrap"><%= t('categories.total_products_count') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-screen-xl mx-auto px-6">
    <% @root_categories.each do |root| %>
      <div class="mb-20">
        <!-- Root Channel Header -->
        <div class="flex items-center gap-4 mb-8 border-b border-slate-200 pb-4">
          <span class="px-3 py-1 bg-primary text-white text-xs font-black rounded-md uppercase">
            <%= case root.category_kind
                when 'apple' then t('navbar.apple')
                when 'oppo' then t('navbar.oppo')
                when 'custom' then t('navbar.custom')
                when 'huawei' then t('navbar.huawei')
                when 'xiaomi' then t('navbar.xiaomi')
                when 'vivo' then t('navbar.vivo')
                when 'samsung' then t('navbar.samsung')
                when 'transsion' then t('navbar.transsion')
                else root.category_kind.upcase
                end %>
          </span>
          <h2 class="text-2xl font-black text-dark tracking-tight">
            <%= link_to root.localized_name, category_path(root), class: "hover:text-primary transition-colors" %>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          <% if @skus_by_category[root.id].present? %>
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
              <%= render "product_index_items", skus: @skus_by_category[root.id] %>
            </div>
          <% end %>
          <% @categories_by_parent.fetch(root.id, []).each do |subcategory| %>
            <article class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
              <%= render "product_index_branch", category: subcategory %>
            </article>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
