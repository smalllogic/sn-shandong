<div class="relative min-h-screen">
  <!-- 1. New Globalization Hero Section (Fast Loading) -->
  <section class="relative bg-slate-900 py-24 lg:py-40 overflow-hidden border-b border-white/5">
    <!-- Industrial Aesthetic Background -->
    <div class="absolute inset-0 z-0">
      <!-- Deep Gradient Background -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(15,23,42,1)_0%,rgba(2,6,23,1)_100%)]"></div>
      
      <!-- Technical Grid with Perspective -->
      <div class="absolute inset-0 opacity-[0.15]" 
           style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 40px 40px;"></div>
      
      <!-- Animated Line -->
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent animate-pulse"></div>
      
      <!-- Corner Decorative Elements -->
      <div class="absolute top-10 left-10 w-20 h-20 border-t border-l border-white/10"></div>
      <div class="absolute bottom-10 right-10 w-20 h-20 border-b border-r border-white/10"></div>
      
      <!-- Side Coordinate Marks -->
      <div class="absolute left-4 top-1/2 -translate-y-1/2 flex flex-col space-y-8 opacity-20">
        <% 5.times do |i| %><div class="w-8 h-px bg-white"></div><% end %>
      </div>
    </div>

    <div class="relative z-10 max-w-screen-xl mx-auto px-6">
      <div class="text-center mb-24">
        <div class="inline-flex items-center gap-3 px-5 py-2.5 bg-accent/10 border border-accent/20 rounded-full text-accent text-[11px] font-black tracking-[0.2em] uppercase mb-8 backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          Global Supply Chain Leader
        </div>
        
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white leading-[1.1] mb-10 tracking-tighter">
          ENGINEERING THE <br>
          <span class="text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-white/40">FUTURE OF KITCHENS</span>
        </h1>
        
        <p class="text-xl text-slate-400 max-w-3xl mx-auto mb-12 leading-relaxed font-medium">
          Premium commercial equipment manufactured with industrial precision. 
          <span class="text-white/60">5 Strategic Global Hubs. 1 Integrated Standard.</span>
        </p>
        
        <div class="flex flex-wrap justify-center gap-6">
          <%= link_to contact_path, class: "group relative px-10 py-5 bg-accent text-white font-black rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-2xl shadow-accent/20 overflow-hidden" do %>
            <span class="relative z-10">REQUEST GLOBAL QUOTE</span>
            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
          <% end %>
          <%= link_to factory_path, class: "px-10 py-5 bg-white/5 border border-white/10 text-white font-black rounded-2xl hover:bg-white/10 transition-all backdrop-blur-md border-dashed" do %>
            EXPLORE FACTORY
          <% end %>
        </div>
      </div>

      <!-- 5 Branches Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <% [
          { name: "China HQ", addr: "Industrial Park, Boxing", icon: "CN", tag: "GLOBAL HUB" },
          { name: "France", addr: "31 Quai de L'industrie, Paris", icon: "FR", tag: "EUROPE" },
          { name: "Germany", addr: "Frühlingstr. 15, Munich", icon: "DE", tag: "EUROPE" },
          { name: "UAE", addr: "Al Wahda St, Sharjah", icon: "AE", tag: "MIDDLE EAST" },
          { name: "USA", addr: "Norcross, GA 30071", icon: "US", tag: "NORTH AMERICA" }
        ].each do |branch| %>
          <div class="bg-white/[0.03] p-6 rounded-2xl border border-white/5 hover:border-accent/30 transition-all group backdrop-blur-sm relative overflow-hidden">
            <div class="absolute top-0 right-0 p-2 opacity-5 font-black text-4xl text-white pointer-events-none"><%= branch[:icon] %></div>
            <div class="flex justify-between items-start mb-8">
              <div class="text-[10px] font-black text-accent tracking-tighter"><%= branch[:tag] %></div>
              <div class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
            </div>
            <h3 class="text-white font-black text-lg mb-2 group-hover:text-accent transition-colors"><%= branch[:name] %></h3>
            <p class="text-[11px] text-slate-500 leading-tight font-medium uppercase tracking-tight"><%= branch[:addr] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 2. Core Data (Digital Trust) -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-16">Global Manufacturing Powerhouse</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="700000" class="counter">0</span>㎡</div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Production Area</div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-primary/5 border border-primary/10 hover:shadow-lg transition-all text-primary group">
          <div class="text-3xl md:text-4xl font-extrabold group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="500" class="counter">0</span>+</div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Employees</div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="550" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Advanced Machines</div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="108" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Countries Served</div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="280000" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Annual Capacity</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Product Categories -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Product Categories</h2>
          <p class="text-slate-600 mt-2">Professional solutions for global foodservice partners</p>
        </div>
        <%= link_to categories_path, class: "text-accent font-bold hover:underline flex items-center" do %>
          View All Categories <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        <% end %>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% [
          { name: "Commercial Refrigeration", image: "sinower-factory2.png", desc: "Refrigerator, Freezer, Cold Storage" },
          { name: "Cooking Equipment", image: "sinower-factory3.png", desc: "Oven, Fryer, Range" },
          { name: "Stainless Steel Kitchenware", image: "sinower-door.png", desc: "Work Table, Sink, Cabinet" }
        ].each do |cat| %>
          <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-slate-100">
            <div class="h-64 overflow-hidden relative">
              <% if File.exist?(Rails.root.join("app/assets/images/#{cat[:image]}")) %>
                <%= image_tag cat[:image], class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
              <% else %>
                <div class="w-full h-full bg-slate-200"></div>
              <% end %>
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-all"></div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-accent transition-colors"><%= cat[:name] %></h3>
              <p class="text-slate-500 mt-2 text-sm"><%= cat[:desc] %></p>
              <div class="mt-6 flex items-center text-slate-900 font-bold text-sm">
                View Products <span class="ml-2 group-hover:translate-x-2 transition-transform text-accent">→</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 4. Manufacturing Capability -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Powerful Manufacturing Capability</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">01</div>
              <div>
                <h4 class="font-bold text-slate-900">700,000㎡ Modern Factory</h4>
                <p class="text-slate-600 text-sm">Large-scale production base ensuring stable supply and scale advantage.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">02</div>
              <div>
                <h4 class="font-bold text-slate-900">550+ Advanced Machines</h4>
                <p class="text-slate-600 text-sm">Equipped with CNC, laser cutting, and automatic welding for precision.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">03</div>
              <div>
                <h4 class="font-bold text-slate-900">OEM / ODM Experts</h4>
                <p class="text-slate-600 text-sm">Professional engineering team for customized kitchen solutions.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <%= image_tag "sinower-factory2.png", class: "w-full aspect-[4/5] object-cover rounded-2xl shadow-lg" %>
            <%= image_tag "sinower-factory3.png", class: "w-full aspect-square object-cover rounded-2xl shadow-lg" %>
          </div>
          <div class="space-y-4 pt-8">
            <%= image_tag "sinower-office.png", class: "w-full aspect-square object-cover rounded-2xl shadow-lg" %>
            <%= image_tag "sinower-factory1.png", class: "w-full aspect-[4/5] object-cover rounded-2xl shadow-lg" %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Quality Control -->
  <section class="py-20 bg-primary text-white">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Rigorous Quality System</h2>
        <p class="text-slate-300">We don't just talk about quality; we demonstrate it through every step.</p>
      </div>
      
      <div class="relative">
        <!-- Connecting Line -->
        <div class="hidden lg:block absolute top-1/2 left-0 w-full h-0.5 bg-white/20 -translate-y-1/2"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-8 relative z-10">
          <% [
            "Raw Material Inspection", "Production Inspection", "Performance Testing", "Final Inspection", "Shipment"
          ].each_with_index do |step, idx| %>
            <div class="bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 text-center relative group hover:border-accent transition-colors">
              <div class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold relative z-10">
                <%= idx + 1 %>
              </div>
              <h4 class="font-bold text-sm uppercase tracking-wider"><%= step %></h4>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-12 items-center grayscale opacity-80 hover:grayscale-0 transition-all duration-500">
         <!-- Placeholder for Certification Logos -->
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">CE</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">Europe Safety</span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">ETL</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">North America</span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">UL</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">Safety Standards</span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">NSF</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">Food Safety</span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">GEMS</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">Energy Rating</span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">ISO</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">9001:2015</span>
         </div>
      </div>
    </div>
  </section>


  <!-- 7. Why Choose Us -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-slate-900 mb-16">Why Global Clients Choose Sinower</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200">
          <thead class="bg-slate-900 text-white">
            <tr>
              <th class="p-6 font-bold">Client Needs</th>
              <th class="p-6 font-bold">Sinower Advantage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="p-6 text-slate-900 font-bold">Stable Supply</td>
              <td class="p-6 text-slate-600">280,000 units/year annual capacity</td>
            </tr>
            <tr>
              <td class="p-6 text-slate-900 font-bold">Cost Leadership</td>
              <td class="p-6 text-slate-600">Large-scale 700,000㎡ manufacturing base</td>
            </tr>
            <tr>
              <td class="p-6 text-slate-900 font-bold">Quick Delivery</td>
              <td class="p-6 text-slate-600">Global logistics network & overseas subsidiaries</td>
            </tr>
            <tr>
              <td class="p-6 text-slate-900 font-bold">Customization</td>
              <td class="p-6 text-slate-600">Professional R&D with OEM/ODM capability</td>
            </tr>
            <tr>
              <td class="p-6 text-slate-900 font-bold">Long-term Trust</td>
              <td class="p-6 text-slate-600">10+ years of export excellence</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 8. Case Study / Projects -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12">Success Stories & Global Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% [
          { title: "Restaurant Chain Project", desc: "Complete kitchen solution for global fast food chains.", img: "sinower-factory1.png" },
          { title: "Hotel Kitchen Solution", desc: "High-end stainless steel equipment for 5-star hotels.", img: "sinower-office.png" },
          { title: "Distributor Partnership", desc: "Strategic cooperation with leading European and US distributors.", img: "sinower-factory2.png" }
        ].each do |item| %>
          <div class="group cursor-pointer">
            <div class="aspect-video rounded-2xl overflow-hidden mb-6 shadow-md border border-slate-100">
              <%= image_tag item[:img], class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            </div>
            <h4 class="text-lg font-bold text-slate-900 group-hover:text-accent transition-colors"><%= item[:title] %></h4>
            <p class="text-slate-500 text-sm mt-2"><%= item[:desc] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 9. News Section (Optional but recommended) -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center">
       <div>
         <h2 class="text-3xl font-bold text-slate-900">Enterprise Updates</h2>
         <p class="text-slate-600 mt-2">Keep up with Sinower's latest development.</p>
       </div>
       <%= link_to posts_path, class: "mt-6 md:mt-0 px-6 py-3 border border-slate-300 rounded-lg font-bold text-slate-900 hover:bg-white transition-all" do %>
         Read More News
       <% end %>
    </div>
  </section>

  <!-- 10. CTA Section -->
  <section class="relative py-24 bg-primary overflow-hidden">
     <div class="absolute inset-0 opacity-20">
        <%= image_tag "sinower-factory1.png", class: "w-full h-full object-cover" %>
     </div>
     <div class="relative z-10 max-w-screen-xl mx-auto px-6 text-center">
       <h2 class="text-3xl md:text-5xl font-bold text-white mb-8">Looking for a Reliable <br>Commercial Kitchen Equipment Supplier?</h2>
       <p class="text-xl text-slate-200 mb-12 max-w-2xl mx-auto">
         Contact Sinower today for a customized quote and professional solution.
       </p>
       <div class="flex flex-wrap justify-center gap-6">
         <%= link_to contact_path, class: "px-10 py-5 bg-accent hover:bg-accent/90 text-white font-bold rounded-xl text-lg shadow-2xl shadow-accent/20 transition-all transform hover:-translate-y-1" do %>
           Get A Quote Now
         <% end %>
       </div>
     </div>
  </section>
</div>
