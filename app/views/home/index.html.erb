          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="8" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.automated_lines') %></div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="180" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.countries_served') %></div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="300000" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.annual_output') %></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Product Categories -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900"><%= t('home.index.categories.title') %></h2>
          <p class="text-slate-600 mt-2"><%= t('home.index.categories.description') %></p>
        </div>
        <%= link_to categories_path, class: "text-accent font-bold hover:underline flex items-center" do %>
          <%= t('home.index.categories.view_all') %> <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        <% end %>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% if @featured_categories.any? %>
          <% @featured_categories.each do |cat| %>
            <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-slate-100">
              <%= link_to channel_path(cat.category_kind, category_id: cat) do %>
                <div class="h-64 overflow-hidden relative">
                  <% if cat.image.attached? %>
                    <%= image_tag cat.image.variant(:featured), class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
                  <% else %>
                    <div class="w-full h-full bg-slate-200"></div>
                  <% end %>
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-all"></div>
                </div>
                <div class="p-8 text-center">
                  <h3 class="text-xl font-bold text-slate-900 group-hover:text-accent transition-colors"><%= cat.localized_name %></h3>
                  <p class="text-slate-500 mt-2 text-xs font-black tracking-[0.2em] uppercase"><%= cat.localized_keywords.presence || "CUSTOM · OEM · ODM" %></p>
                  <div class="mt-6 flex items-center justify-center text-slate-900 font-bold text-sm">
                    <%= t('home.index.categories.view_products') %> <span class="ml-2 group-hover:translate-x-2 transition-transform text-accent">→</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <% [
            { name: t('home.index.categories.refrigeration.name'), image: "sinower-factory2.png", desc: t('home.index.categories.refrigeration.description') },
            { name: t('home.index.categories.cooking.name'), image: "sinower-factory3.png", desc: t('home.index.categories.cooking.description') },
            { name: t('home.index.categories.kitchenware.name'), image: "sinower-door.png", desc: t('home.index.categories.kitchenware.description') }
          ].each do |cat| %>
            <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-slate-100">
              <div class="h-64 overflow-hidden relative">
                <% if File.exist?(Rails.root.join("app/assets/images/#{cat[:image]}")) %>
                  <%= image_tag cat[:image], class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
                <% else %>
                  <div class="w-full h-full bg-slate-200"></div>
                <% end %>
                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-all"></div>
              </div>
              <div class="p-8">
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-accent transition-colors"><%= cat[:name] %></h3>
                <p class="text-slate-500 mt-2 text-sm"><%= cat[:desc] %></p>
                <div class="mt-6 flex items-center text-slate-900 font-bold text-sm">
                  <%= t('home.index.categories.view_products') %> <span class="ml-2 group-hover:translate-x-2 transition-transform text-accent">→</span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

