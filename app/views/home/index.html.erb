                <p class="text-slate-600 text-sm"><%= t('home.index.capability.lines_description') %></p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">03</div>
