            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
          <% end %>
          <%= link_to factory_path, class: "px-10 py-5 bg-white/5 border border-white/10 text-white font-black rounded-2xl hover:bg-white/10 transition-all backdrop-blur-md border-dashed" do %>
            <%= t('home.index.hero.explore_factory') %>
          <% end %>
        </div>

        <!-- 5 Branches Grid -->
        <div class="flex flex-wrap justify-center gap-4 max-w-6xl mx-auto w-full">
          <% [
            { name: t('home.branches.china'), addr: t('home.branches.boxing'), flag: "🇨🇳", tag: t('home.branches.global_hub') },
            { name: t('home.branches.france'), addr: t('home.branches.paris'), flag: "🇫🇷", tag: t('home.branches.europe') },
            { name: t('home.branches.germany'), addr: t('home.branches.munich'), flag: "🇩🇪", tag: t('home.branches.europe') },
            { name: t('home.branches.czech'), addr: t('home.branches.czech_republic'), flag: "🇨🇿", tag: t('home.branches.europe') },
            { name: t('home.branches.spain'), addr: t('home.branches.madrid'), flag: "🇪🇸", tag: t('home.branches.europe') },
            { name: t('home.branches.uk'), addr: t('home.branches.london'), flag: "🇬🇧", tag: t('home.branches.europe') },
            { name: t('home.branches.australia'), addr: t('home.branches.sydney'), flag: "🇦🇺", tag: t('home.branches.global_hub') },
            { name: t('home.branches.uae'), addr: t('home.branches.sharjah'), flag: "🇦🇪", tag: t('home.branches.middle_east') },
            { name: t('home.branches.usa'), addr: t('home.branches.georgia'), flag: "🇺🇸", tag: t('home.branches.north_america') }
          ].each do |branch| %>
            <div class="bg-white/[0.03] p-4 rounded-xl border border-white/5 hover:border-accent/30 transition-all group backdrop-blur-sm relative overflow-hidden w-full sm:w-[calc(50%-1rem)] md:w-[calc(33.33%-1rem)] lg:w-[calc(20%-1rem)] min-w-[160px]">
              <div class="flex justify-between items-center mb-4">
                <div class="text-[9px] font-black text-accent tracking-tighter uppercase"><%= branch[:tag] %></div>
                <div class="flex items-center gap-2">
                  <span class="text-xl drop-shadow-sm"><%= branch[:flag] %></span>
                  <div class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></div>
                </div>
              </div>
              <h3 class="text-white font-black text-sm group-hover:text-accent transition-colors"><%= branch[:name] %></h3>
              <p class="text-[10px] text-slate-500 font-medium uppercase tracking-tight"><%= branch[:addr] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <script type="module">
    import createGlobe from 'https://cdn.jsdelivr.net/npm/cobe@0.6.3/+esm'

    const canvas = document.getElementById('globe-canvas')
    if (canvas) {
      let phi = 0
      let isVisible = true
      let pulse = 0

      const locations = {
        china:   [37.155, 118.111],
        usa:     [33.941, -84.214],
        france:  [48.707, 2.389],
        germany: [48.266, 10.985],
        czech:   [49.8175, 15.4730],
        uae:     [25.340, 55.400]
      }

      const globe = createGlobe(canvas, {
        devicePixelRatio: 1,
        width: 1000,
        height: 1000,
        phi: 0,
        theta: 0.25,
        dark: 1,
        diffuse: 1.0,
        mapSamples: 800,
        mapBrightness: 6,
        baseColor: [0.1, 0.15, 0.3],
        markerColor: [0.1, 0.8, 1],
        glowColor: [0.1, 0.3, 0.6],
        markers: [
          { location: locations.china, size: 0.1 },
          { location: locations.usa, size: 0.08 },
          { location: locations.france, size: 0.08 },
          { location: locations.germany, size: 0.08 },
          { location: locations.czech, size: 0.08 },
          { location: locations.uae, size: 0.08 }
        ],
        arcs: [],
        onRender: (state) => {
          if (!isVisible) return

          state.phi = phi
          phi += 0.003

          // Simple pulse effect for markers to make them noticeable without high CPU cost
          pulse += 0.05
          const scale = 1 + Math.sin(pulse) * 0.3
          state.markers = [
            { location: locations.china, size: 0.15 * scale, color: [0.2, 1, 0.4] },
            { location: locations.usa, size: 0.1 * scale, color: [0.2, 1, 0.4] },
            { location: locations.france, size: 0.1 * scale, color: [0.2, 1, 0.4] },
            { location: locations.germany, size: 0.1 * scale, color: [0.2, 1, 0.4] },
            { location: locations.czech, size: 0.1 * scale, color: [0.2, 1, 0.4] },
            { location: locations.uae, size: 0.1 * scale, color: [0.2, 1, 0.4] }
          ]
        }
      })

      function resize() {
        const size = canvas.parentElement.offsetWidth
        globe.update({
          width: Math.min(size, 1000),
          height: Math.min(size, 1000)
        })
      }

      const handleVisibilityChange = () => {
        isVisible = document.visibilityState === 'visible'
      }

      const cleanup = () => {
        globe.destroy()
        window.removeEventListener('resize', resize)
        document.removeEventListener('visibilitychange', handleVisibilityChange)
      }

      window.addEventListener('resize', resize)
      document.addEventListener('visibilitychange', handleVisibilityChange)
      resize()
      
      // Handle Turbo navigation to ensure resources are freed
      document.addEventListener("turbo:visit", cleanup, { once: true })
      document.addEventListener("turbo:before-cache", cleanup, { once: true })
    }
  </script>

  <!-- 2. Core Data (Digital Trust) -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-16"><%= t('home.index.metrics.title') %></h2>
