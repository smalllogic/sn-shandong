<div class="relative min-h-screen">
  <!-- 1. New Globalization Hero Section (Fast Loading) -->
  <section class="relative bg-slate-900 py-24 lg:py-40 overflow-hidden border-b border-white/5 min-h-[850px] flex items-center">
    <!-- Globe Background -->
    <div class="absolute inset-0 z-0 flex items-center justify-center overflow-hidden pointer-events-none">
      <div class="relative w-full h-full max-w-[1000px] max-h-[1000px] aspect-square">
        <canvas id="globe-canvas" style="width: 100%; height: 100%; opacity: 0.8;"></canvas>
      </div>
      <!-- Radial Overlay for depth -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(15,23,42,0)_0%,rgba(15,23,42,0.6)_70%,rgba(15,23,42,1)_100%)] pointer-events-none"></div>
    </div>

    <div class="relative z-10 max-w-screen-xl mx-auto px-6 w-full text-center flex flex-col items-center">
      <div class="mb-12">
        <div class="inline-flex items-center gap-3 px-5 py-2.5 bg-accent/20 border border-accent/30 rounded-full text-accent text-[11px] font-black tracking-[0.2em] uppercase mb-8 backdrop-blur-xl">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          <%= t('home.index.hero.badge') %>
        </div>
        
        <h1 class="text-6xl md:text-8xl lg:text-9xl font-black text-white leading-[1.05] mb-8 tracking-tighter drop-shadow-2xl">
          <%= t('home.index.hero.title_line_one') %> <br>
          <span class="text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-white/30"><%= t('home.index.hero.title_line_two') %></span>
        </h1>
        
        <p class="text-xl text-slate-400 max-w-3xl mx-auto mb-12 leading-relaxed font-medium">
          <%= t('home.index.hero.description') %>
          <span class="text-white/60"><%= t('home.index.hero.highlight') %></span>
        </p>
      </div>
      
      <div class="w-full flex flex-col items-center">
        <div class="flex flex-wrap justify-center gap-6 mb-24">
          <%= link_to contact_path, class: "group relative px-10 py-5 bg-accent text-white font-black rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-2xl shadow-accent/20 overflow-hidden" do %>
