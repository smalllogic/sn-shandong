        <p class="text-slate-300"><%= t('home.index.quality.description') %></p>
      </div>
      
      <div class="relative">
        <!-- Connecting Line -->
        <div class="hidden lg:block absolute top-1/2 left-0 w-full h-0.5 bg-white/20 -translate-y-1/2"></div>
        
