<% content_for :title, t('seo.home.title') %>
<% content_for :meta_description, t('seo.home.description') %>

<div class="relative min-h-screen">
  <%= render "hero_globe" %>

  <!-- 2. Core Data (Digital Trust) -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-16"><%= t('home.index.metrics.title') %></h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="700000" class="counter">0</span>㎡</div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.production_area') %></div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-primary/5 border border-primary/10 hover:shadow-lg transition-all text-primary group">
          <div class="text-3xl md:text-4xl font-extrabold group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="500" class="counter">0</span>+</div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.employees') %></div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="8" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.automated_lines') %></div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="180" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.countries_served') %></div>
        </div>
        <div class="space-y-2 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-all group">
          <div class="text-3xl md:text-4xl font-extrabold text-primary group-hover:scale-110 transition-transform"><span data-controller="counter" data-target-value="300000" class="counter">0</span></div>
          <div class="text-slate-500 text-xs font-bold uppercase tracking-wider"><%= t('home.index.metrics.annual_output') %></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Product Categories -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900"><%= t('home.index.categories.title') %></h2>
          <p class="text-slate-600 mt-2"><%= t('home.index.categories.description') %></p>
        </div>
        <%= link_to categories_path, class: "text-accent font-bold hover:underline flex items-center" do %>
          <%= t('home.index.categories.view_all') %> <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        <% end %>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% if @featured_categories.any? %>
          <% @featured_categories.each do |cat| %>
            <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-slate-100">
              <%= link_to channel_path(cat.category_kind, category_id: cat) do %>
                <div class="h-64 overflow-hidden relative">
                  <% if cat.image.attached? %>
                    <%= image_tag cat.image.variant(:featured), class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
                  <% else %>
                    <div class="w-full h-full bg-slate-200"></div>
                  <% end %>
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-all"></div>
                </div>
                <div class="p-8 text-center">
                  <h3 class="text-xl font-bold text-slate-900 group-hover:text-accent transition-colors"><%= cat.localized_name %></h3>
                  <p class="text-slate-500 mt-2 text-xs font-black tracking-[0.2em] uppercase"><%= cat.localized_keywords.presence || "CUSTOM · OEM · ODM" %></p>
                  <div class="mt-6 flex items-center justify-center text-slate-900 font-bold text-sm">
                    <%= t('home.index.categories.view_products') %> <span class="ml-2 group-hover:translate-x-2 transition-transform text-accent">→</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <% [
            { name: t('home.index.categories.refrigeration.name'), image: "sinower-factory2.png", desc: t('home.index.categories.refrigeration.description') },
            { name: t('home.index.categories.cooking.name'), image: "sinower-factory3.png", desc: t('home.index.categories.cooking.description') },
            { name: t('home.index.categories.kitchenware.name'), image: "sinower-door.png", desc: t('home.index.categories.kitchenware.description') }
          ].each do |cat| %>
            <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-slate-100">
              <div class="h-64 overflow-hidden relative">
                <% if File.exist?(Rails.root.join("app/assets/images/#{cat[:image]}")) %>
                  <%= image_tag cat[:image], class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
                <% else %>
                  <div class="w-full h-full bg-slate-200"></div>
                <% end %>
                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-all"></div>
              </div>
              <div class="p-8">
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-accent transition-colors"><%= cat[:name] %></h3>
                <p class="text-slate-500 mt-2 text-sm"><%= cat[:desc] %></p>
                <div class="mt-6 flex items-center text-slate-900 font-bold text-sm">
                  <%= t('home.index.categories.view_products') %> <span class="ml-2 group-hover:translate-x-2 transition-transform text-accent">→</span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 4. Manufacturing Capability -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900"><%= t('home.index.capability.title') %></h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">01</div>
              <div>
                <h4 class="font-bold text-slate-900"><%= t('home.index.capability.factory_title') %></h4>
                <p class="text-slate-600 text-sm"><%= t('home.index.capability.factory_description') %></p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">02</div>
              <div>
                <h4 class="font-bold text-slate-900"><%= t('home.index.capability.lines_title') %></h4>
                <p class="text-slate-600 text-sm"><%= t('home.index.capability.lines_description') %></p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center flex-shrink-0 text-accent font-bold">03</div>
              <div>
                <h4 class="font-bold text-slate-900"><%= t('home.index.capability.engineers_title') %></h4>
                <p class="text-slate-600 text-sm"><%= t('home.index.capability.engineers_description') %></p>
              </div>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <%= image_tag "sinower-factory2.png", class: "w-full aspect-[4/5] object-cover rounded-2xl shadow-lg" %>
            <%= image_tag "sinower-factory3.png", class: "w-full aspect-square object-cover rounded-2xl shadow-lg" %>
          </div>
          <div class="space-y-4 pt-8">
            <%= image_tag "sinower-office.png", class: "w-full aspect-square object-cover rounded-2xl shadow-lg" %>
            <%= image_tag "sinower-factory1.png", class: "w-full aspect-[4/5] object-cover rounded-2xl shadow-lg" %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Quality Control -->
  <section class="py-20 bg-primary text-white">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4"><%= t('home.index.quality.title') %></h2>
        <p class="text-slate-300"><%= t('home.index.quality.description') %></p>
      </div>
      
      <div class="relative">
        <!-- Connecting Line -->
        <div class="hidden lg:block absolute top-1/2 left-0 w-full h-0.5 bg-white/20 -translate-y-1/2"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-8 relative z-10">
          <% t('home.index.quality.steps').each_with_index do |step, idx| %>
            <div class="bg-white/5 backdrop-blur-md p-6 rounded-xl border border-white/10 text-center relative group hover:border-accent transition-colors">
              <div class="w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold relative z-10">
                <%= idx + 1 %>
              </div>
              <h4 class="font-bold text-sm uppercase tracking-wider"><%= step %></h4>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-12 items-center grayscale opacity-80 hover:grayscale-0 transition-all duration-500">
         <!-- Placeholder for Certification Logos -->
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">CE</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold"><%= t('home.index.quality.certifications.europe_safety') %></span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">ETL</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold"><%= t('home.index.quality.certifications.north_america') %></span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">UL</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold"><%= t('home.index.quality.certifications.safety_standards') %></span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">NSF</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold"><%= t('home.index.quality.certifications.food_safety') %></span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">GEMS</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold"><%= t('home.index.quality.certifications.energy_rating') %></span>
         </div>
         <div class="flex flex-col items-center group">
            <span class="text-4xl font-black group-hover:text-accent transition-colors">ISO</span>
            <span class="text-[10px] text-slate-500 mt-1 font-bold">9001:2015</span>
         </div>
      </div>
    </div>
  </section>


  <!-- 7. Why Choose Us -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-slate-900 mb-16"><%= t('home.index.advantages.title') %></h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200">
          <thead class="bg-slate-900 text-white">
            <tr>
              <th class="p-6 font-bold"><%= t('home.index.advantages.client_needs') %></th>
              <th class="p-6 font-bold"><%= t('home.index.advantages.sinower_advantage') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% t('home.index.advantages.rows').each do |row| %>
              <tr>
                <td class="p-6 text-slate-900 font-bold"><%= row[:need] %></td>
                <td class="p-6 text-slate-600"><%= row[:advantage] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 8. Case Study / Projects -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12"><%= t('home.index.projects.title') %></h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% [
          { title: t('home.index.projects.restaurant.title'), desc: t('home.index.projects.restaurant.description'), img: "sinower-factory1.png" },
          { title: t('home.index.projects.hotel.title'), desc: t('home.index.projects.hotel.description'), img: "sinower-office.png" },
          { title: t('home.index.projects.distributor.title'), desc: t('home.index.projects.distributor.description'), img: "sinower-factory2.png" }
        ].each do |item| %>
          <div class="group cursor-pointer">
            <div class="aspect-video rounded-2xl overflow-hidden mb-6 shadow-md border border-slate-100">
              <%= image_tag item[:img], class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            </div>
            <h4 class="text-lg font-bold text-slate-900 group-hover:text-accent transition-colors"><%= item[:title] %></h4>
            <p class="text-slate-500 text-sm mt-2"><%= item[:desc] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 9. News Section (Optional but recommended) -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center">
       <div>
         <h2 class="text-3xl font-bold text-slate-900"><%= t('home.index.news.title') %></h2>
         <p class="text-slate-600 mt-2"><%= t('home.index.news.description') %></p>
       </div>
       <%= link_to posts_path, class: "mt-6 md:mt-0 px-6 py-3 border border-slate-300 rounded-lg font-bold text-slate-900 hover:bg-white transition-all" do %>
         <%= t('home.index.news.read_more') %>
       <% end %>
    </div>
  </section>

  <!-- 10. CTA Section -->
  <section class="relative py-24 bg-primary overflow-hidden">
     <div class="absolute inset-0 opacity-20">
        <%= image_tag "sinower-factory1.png", class: "w-full h-full object-cover" %>
     </div>
     <div class="relative z-10 max-w-screen-xl mx-auto px-6 text-center">
       <h2 class="text-3xl md:text-5xl font-bold text-white mb-8"><%= t('home.index.cta.title_line_one') %> <br><%= t('home.index.cta.title_line_two') %></h2>
       <p class="text-xl text-slate-200 mb-12 max-w-2xl mx-auto">
         <%= t('home.index.cta.description') %>
       </p>
       <div class="flex flex-wrap justify-center gap-6">
         <%= link_to contact_path, class: "px-10 py-5 bg-accent hover:bg-accent/90 text-white font-bold rounded-xl text-lg shadow-2xl shadow-accent/20 transition-all transform hover:-translate-y-1" do %>
           <%= t('home.index.cta.button') %>
         <% end %>
       </div>
     </div>
  </section>
</div>
