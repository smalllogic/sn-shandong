<footer class="bg-slate-900 border-t border-white/5 relative overflow-hidden pt-16 pb-8">
  <!-- subtle background pattern -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
  
  <div class="mx-auto w-full max-w-screen-xl px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Column 1: Brand & Certs -->
      <div class="space-y-6">
        <a href="<%= root_path %>" class="block">
          <%= image_tag "logo.png", class: "h-12 w-auto brightness-0 invert opacity-90", alt: "Sinower Logo" %>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed">
          <%= t('footer.company_desc') %>
        </p>
        <!-- Certificates -->
        <div class="pt-4 border-t border-white/5">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3">Certified Quality</p>
          <div class="flex flex-wrap gap-3 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500">
            <span class="px-2 py-1 bg-white/5 rounded border border-white/10 text-[10px] text-white font-black">CE</span>
            <span class="px-2 py-1 bg-white/5 rounded border border-white/10 text-[10px] text-white font-black">ETL</span>
            <span class="px-2 py-1 bg-white/5 rounded border border-white/10 text-[10px] text-white font-black">UL</span>
            <span class="px-2 py-1 bg-white/5 rounded border border-white/10 text-[10px] text-white font-black">NSF</span>
            <span class="px-2 py-1 bg-white/5 rounded border border-white/10 text-[10px] text-white font-black">GEMS</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Solutions -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-6">Our Solutions</h3>
        <ul class="space-y-4 text-sm">
          <% Category.visible.roots.limit(5).each do |cat| %>
            <li>
              <%= link_to cat.localized_name, category_path(cat), class: "text-slate-400 hover:text-accent transition-colors flex items-center group" %>
            </li>
          <% end %>
          <li>
            <%= link_to t('navbar.customize'), customize_path, class: "text-slate-400 hover:text-accent transition-colors flex items-center group" %>
          </li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-6">Company</h3>
        <ul class="space-y-4 text-sm">
          <li><%= link_to t('navbar.home'), root_path, class: "text-slate-400 hover:text-accent transition-colors" %></li>
          <li><%= link_to t('navbar.factory'), factory_path, class: "text-slate-400 hover:text-accent transition-colors" %></li>
          <li><%= link_to t('navbar.blog'), posts_path, class: "text-slate-400 hover:text-accent transition-colors" %></li>
          <li><%= link_to t('navbar.faqs'), faqs_path, class: "text-slate-400 hover:text-accent transition-colors" %></li>
          <li><%= link_to t('navbar.contact_us'), contact_path, class: "text-slate-400 hover:text-accent transition-colors" %></li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-6">Contact Us</h3>
        <div class="space-y-4 text-sm">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span class="text-slate-400 leading-relaxed"><%= t('footer.address') %></span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:<%= t('footer.phone') %>" class="text-slate-400 hover:text-white transition-colors"><%= t('footer.phone') %></a>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:<%= t('footer.email') %>" class="text-slate-400 hover:text-white transition-colors"><%= t('footer.email') %></a>
          </div>
          
          <!-- Social Icons -->
          <div class="pt-4 flex items-center gap-4">
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-slate-400 hover:bg-accent hover:text-white transition-all duration-300 group/social">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-slate-400 hover:bg-accent hover:text-white transition-all duration-300 group/social">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22.23 0H1.77C.8 0 0 .8 0 1.77v20.46C0 23.2.8 24 1.77 24h20.46c.98 0 1.77-.8 1.77-1.77V1.77C24 .8 23.2 0 22.23 0zM7.12 20.45H3.56V9h3.56v11.45zM5.34 7.58c-1.14 0-2.06-.92-2.06-2.06 0-1.14.92-2.06 2.06-2.06 1.14 0 2.06.92 2.06 2.06 0 1.14-.92 2.06-2.06 2.06zM20.45 20.45h-3.56v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.15 1.46-2.15 2.96v5.7h-3.56V9h3.42v1.56h.05c.48-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-slate-500 text-xs text-center md:text-left">
        © <%= Time.current.year %> <%= @site_config.name %>. All Rights Reserved.
      </div>
      <div class="flex items-center gap-6">
        <%= link_to t('privacy_policy.title'), privacy_path, class: "text-slate-500 hover:text-slate-300 text-xs transition-colors" %>
      </div>
    </div>
  </div>
</footer>
