<div class="relative z-40">
  <nav class="fixed w-full z-50 top-0 start-0 transition-all duration-300" 
       data-controller="navbar"
       x-data="{ mobileMenuOpen: false }">
    
    <!-- Main Navigation Bar -->
    <div class="bg-white shadow-sm transition-all duration-300">
      <!-- Top Level: Basic Pages & Branding -->
      <div class="border-b border-slate-50">
        <div class="max-w-screen-2xl mx-auto px-4 md:px-8 h-16 flex justify-between items-center">
          <!-- Logo -->
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center group" do %>
              <%= image_tag "logo.png", class: "h-9 w-auto transition-all duration-300" %>
            <% end %>
          </div>

          <!-- Basic Pages Links -->
          <div class="hidden lg:flex items-center space-x-4 xl:space-x-8">
            <%= link_to t('navbar.home'), root_path, class: "text-[12px] xl:text-[13px] font-bold uppercase tracking-wider #{current_page?(root_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
            <%= link_to t('navbar.factory'), factory_path, class: "text-[12px] xl:text-[13px] font-bold uppercase tracking-wider #{current_page?(factory_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
            <%= link_to t('navbar.blog'), posts_path, class: "text-[12px] xl:text-[13px] font-bold uppercase tracking-wider #{current_page?(posts_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
            <%= link_to t('navbar.faqs'), faqs_path, class: "text-[12px] xl:text-[13px] font-bold uppercase tracking-wider #{current_page?(faqs_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
            <%= link_to t('navbar.contact_us'), contact_path, class: "text-[12px] xl:text-[13px] font-bold uppercase tracking-wider #{current_page?(contact_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
          </div>

          <!-- Right Side Actions -->
          <div class="flex items-center space-x-4">
            <!-- Language selector -->
            <div class="hidden md:flex items-center space-x-2 text-[11px] font-bold border-r border-slate-100 pr-4 mr-2">
              <span class="text-slate-900">EN</span>
              <span class="text-slate-300">|</span>
              <span class="text-slate-500 hover:text-accent cursor-pointer transition-colors">CN</span>
            </div>

            <!-- Search Toggle -->
            <div class="relative group/search" x-data="{ open: false }">
              <button @click="open = !open" class="p-2 text-slate-600 hover:text-accent transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              </button>
              <div x-show="open" 
                   x-transition:enter="transition ease-out duration-200"
                   x-transition:enter-start="opacity-0 scale-95"
                   x-transition:enter-end="opacity-100 scale-100"
                   @click.away="open = false"
                   x-cloak
                   class="absolute right-0 top-full mt-2 w-72 bg-white border border-slate-100 rounded-2xl shadow-2xl p-4 z-[60]">
                <%= form_with url: products_path, method: :get, class: "relative" do %>
                  <%= text_field_tag :q, params[:q], placeholder: t('navbar.search_placeholder'), class: "w-full pl-4 pr-10 py-2.5 text-sm border-slate-100 rounded-xl bg-slate-50 focus:ring-accent focus:border-accent transition-all" %>
                  <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-accent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                  </button>
                <% end %>
              </div>
            </div>
          
            <div class="hidden sm:block">
              <%= link_to contact_path, class: "px-5 py-2 bg-primary text-white text-[11px] font-black rounded-lg hover:bg-accent transition-all shadow-lg shadow-primary/10 uppercase tracking-tighter flex items-center group" do %>
                <span>Get Quote</span>
                <svg class="w-3.5 h-3.5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              <% end %>
            </div>

            <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" class="md:hidden p-2 text-slate-600 hover:text-accent transition-colors">
              <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
              <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Bottom Level: Product Categories -->
      <div class="hidden md:block bg-slate-50/50">
        <div class="max-w-screen-2xl mx-auto px-8">
          <div class="flex items-center justify-center space-x-1 py-1">
            <% Category.roots.visible.each do |category| %>
              <div class="relative group/mega">
                <%= link_to category_path(category), class: "flex items-center px-4 py-3 text-[12px] font-bold uppercase tracking-widest #{current_page?(category_path(category)) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors cursor-pointer" do %>
                  <span><%= category.localized_name %></span>
                  <% if category.children.visible.any? %>
                    <svg class="w-3 h-3 ml-1.5 transition-transform group-hover/mega:rotate-180 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  <% end %>
                <% end %>
                
                <% if category.children.visible.any? %>
                  <div class="invisible group-hover/mega:visible absolute left-1/2 -translate-x-1/2 top-full pt-0 z-50 w-64 opacity-0 group-hover/mega:opacity-100 transition-all duration-300 transform translate-y-2 group-hover/mega:translate-y-0">
                    <div class="bg-white border border-slate-100 rounded-b-2xl shadow-xl overflow-hidden p-5">
                      <div class="flex flex-col space-y-2.5">
                        <% category.children.visible.each do |sub| %>
                          <%= link_to sub.localized_name, category_path(sub), class: "text-[12px] font-medium text-slate-500 hover:text-accent transition-colors py-1 block border-b border-slate-50 last:border-0" %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Menu: Professional Overlay -->
    <div x-show="mobileMenuOpen" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-4"
         class="md:hidden fixed inset-0 z-20 pt-[72px]" 
         x-cloak>
      <div class="bg-white min-h-screen flex flex-col p-6 overflow-y-auto">
        <div class="space-y-8">
          <div>
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] block mb-6">Product Range</span>
            <div class="grid grid-cols-1 gap-2">
              <% Category.roots.visible.each do |category| %>
                <div x-data="{ open: false }">
                  <div class="flex items-center justify-between py-4 px-5 text-sm font-bold text-slate-900 bg-slate-50 rounded-2xl hover:bg-accent hover:text-white transition-all cursor-pointer"
                       @click="open = !open">
                    <span><%= category.localized_name %></span>
                    <% if category.children.visible.any? %>
                      <svg class="w-4 h-4 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    <% end %>
                  </div>
                  <% if category.children.visible.any? %>
                    <div x-show="open" x-collapse class="pl-4 space-y-1 mt-2">
                      <% category.children.visible.each do |sub| %>
                        <%= link_to sub.localized_name, category_path(sub), class: "block py-2 px-4 text-sm text-slate-600 hover:text-accent" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
          
          <div class="pt-8 border-t border-slate-100">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] block mb-6">Quick Access</span>
            <div class="space-y-4">
              <%= link_to t('navbar.home'), root_path, class: "block text-lg font-black text-slate-900" %>
              <%= link_to t('navbar.factory'), factory_path, class: "block text-lg font-black text-slate-900" %>
              <%= link_to t('navbar.blog'), posts_path, class: "block text-lg font-black text-slate-900" %>
              <%= link_to t('navbar.contact_us'), contact_path, class: "block text-lg font-black text-slate-900" %>
            </div>
          </div>

          <div class="pt-8 border-t border-slate-100 pb-20">
            <div class="bg-primary rounded-3xl p-6 text-white">
              <h4 class="text-lg font-black mb-2">Ready to Start?</h4>
              <p class="text-slate-300 text-sm mb-6">Get a professional kitchen solution for your project.</p>
              <%= link_to contact_path, class: "block w-full py-4 bg-accent text-center font-black rounded-2xl shadow-lg shadow-accent/20" do %>
                REQUEST A QUOTE
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
  <!-- Spacer to prevent content jump -->
  <div class="h-[72px] md:h-[112px]"></div>
</div>
