<div class="relative z-40">
  <nav class="fixed w-full z-50 top-0 start-0 transition-all duration-300" 
       data-controller="navbar"
       x-data="{ mobileMenuOpen: false }">
    
    <!-- Level 1: Info Bar -->
    <div class="hidden md:block bg-primary text-slate-300 border-b border-white/5 transition-all duration-300 origin-top overflow-hidden"
         :class="scrolled ? 'h-0 opacity-0' : 'h-10 opacity-100'">
      <div class="h-10 max-w-screen-2xl mx-auto px-8 flex justify-between items-center text-[11px] font-medium tracking-wider">
        <div class="flex items-center space-x-6">
          <div class="flex items-center">
            <svg class="w-3.5 h-3.5 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span><%= t('footer.phone') %></span>
          </div>
          <div class="flex items-center border-l border-white/10 pl-6">
            <svg class="w-3.5 h-3.5 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span><%= t('footer.email') %></span>
          </div>
        </div>
        <div class="flex items-center space-x-6 uppercase font-bold text-[10px]">
          <%= link_to t('navbar.blog'), posts_path, class: "hover:text-white transition-colors" %>
          <%= link_to t('navbar.factory'), factory_path, class: "hover:text-white transition-colors" %>
          <div class="flex items-center space-x-2 border-l border-white/10 pl-6">
            <span class="text-white">EN</span>
            <span class="text-slate-500">|</span>
            <span class="hover:text-white cursor-pointer transition-colors">CN</span>
          </div>
        </div>
      </div>
    </div>

  <!-- Level 2: Main Navigation Bar -->
  <div class="transition-all duration-300"
       :class="scrolled ? 'bg-white/95 backdrop-blur-md py-3 shadow-xl' : 'bg-white py-5 shadow-sm'">
      <div class="max-w-screen-2xl mx-auto px-4 md:px-8 flex justify-between items-center relative">
        
        <!-- Logo -->
        <div class="flex items-center">
          <%= link_to root_path, class: "flex items-center group" do %>
            <%= image_tag "logo.png", 
                class: "h-10 w-auto transition-all duration-300", 
                ":class": "scrolled ? 'h-8' : 'h-10'" %>
            <div class="ml-3 hidden lg:block">
              <span class="block text-lg font-black tracking-tighter leading-none text-slate-900 uppercase">SINOWER</span>
              <span class="block text-[8px] font-bold tracking-[0.3em] text-slate-500 uppercase">Kitchen Solutions</span>
            </div>
          <% end %>
        </div>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center space-x-1 lg:space-x-2">
          <%= link_to t('navbar.home'), root_path, 
              class: "px-4 py-2 text-[13px] font-bold uppercase tracking-wider #{current_page?(root_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
          
          <!-- Products Dropdown (Mega Menu Trigger) -->
          <div class="relative group/mega">
            <%= link_to categories_path, class: "flex items-center px-4 py-2 text-[13px] font-bold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition-colors cursor-pointer" do %>
              <span><%= t('navbar.all_products') %></span>
              <svg class="w-3 h-3 ml-1.5 transition-transform group-hover/mega:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            <% end %>
            
            <div class="invisible group-hover/mega:visible absolute left-1/2 -translate-x-1/2 top-full pt-4 z-50 w-screen max-w-6xl opacity-0 group-hover/mega:opacity-100 transition-all duration-300 transform translate-y-2 group-hover/mega:translate-y-0">
              <div class="mx-4 bg-white border border-slate-100 rounded-[2rem] shadow-[0_30px_60px_rgba(0,0,0,0.12)] overflow-hidden">
                <div class="grid grid-cols-5 p-10 gap-8">
                  <% Category.roots.visible.each do |category| %>
                    <div class="space-y-4">
                      <%= link_to category.localized_name, category_path(category), class: "block text-sm font-black text-slate-900 hover:text-accent transition-colors border-b border-slate-50 pb-2 uppercase tracking-wide" %>
                      <div class="flex flex-col space-y-2">
                        <% category.children.visible.limit(5).each do |sub| %>
                          <%= link_to sub.localized_name, category_path(sub), class: "text-[12px] text-slate-500 hover:text-accent transition-colors" %>
                        <% end %>
                        <% if category.children.visible.count > 5 %>
                          <%= link_to "View All +", category_path(category), class: "text-[10px] font-bold text-accent uppercase pt-1" %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="bg-slate-50 p-6 flex justify-between items-center border-t border-slate-100">
                  <div class="flex items-center space-x-4">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Global Service:</span>
                    <span class="text-xs font-black text-slate-900">108+ Countries Supported</span>
                  </div>
                  <%= link_to categories_path, class: "text-xs font-black text-accent hover:underline uppercase tracking-tighter" do %>
                    Explore Full Catalog →
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <%= link_to t('navbar.factory'), factory_path, 
              class: "px-4 py-2 text-[13px] font-bold uppercase tracking-wider #{current_page?(factory_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
          
          <%= link_to t('navbar.faqs'), faqs_path, 
              class: "px-4 py-2 text-[13px] font-bold uppercase tracking-wider #{current_page?(faqs_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
          
          <%= link_to t('navbar.contact_us'), contact_path, 
              class: "px-4 py-2 text-[13px] font-bold uppercase tracking-wider #{current_page?(contact_path) ? 'text-accent' : 'text-slate-600 hover:text-slate-900'} transition-colors" %>
        </div>

        <!-- Right Side Actions -->
        <div class="flex items-center space-x-2 md:space-x-4">
          <!-- Search Toggle -->
          <div class="relative group/search" x-data="{ open: false }">
            <button @click="open = !open" class="p-2 text-slate-600 hover:text-accent transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </button>
            <div x-show="open" 
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 @click.away="open = false"
                 class="absolute right-0 top-full mt-2 w-72 bg-white border border-slate-100 rounded-2xl shadow-2xl p-4 z-[60]">
              <%= form_with url: products_path, method: :get, class: "relative" do %>
                <%= text_field_tag :q, params[:q], placeholder: t('navbar.search_placeholder'), class: "w-full pl-4 pr-10 py-2.5 text-sm border-slate-100 rounded-xl bg-slate-50 focus:ring-accent focus:border-accent transition-all" %>
                <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-accent">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>
              <% end %>
            </div>
          </div>
        
          <div class="hidden sm:block">
            <%= link_to contact_path, class: "px-6 py-2.5 bg-primary text-white text-[11px] font-black rounded-xl hover:bg-accent transition-all shadow-xl shadow-primary/10 uppercase tracking-tighter flex items-center group" do %>
              <span>Get Quote</span>
              <svg class="w-3.5 h-3.5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            <% end %>
          </div>

          <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" class="md:hidden p-2 text-slate-600 hover:text-accent transition-colors">
            <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu: Professional Overlay -->
    <div x-show="mobileMenuOpen" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-4"
         class="md:hidden fixed inset-0 z-20 pt-[72px]" 
         x-cloak>
      <div class="bg-white min-h-screen flex flex-col p-6 overflow-y-auto">
        <div class="space-y-8">
          <div>
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] block mb-6">Product Range</span>
            <div class="grid grid-cols-1 gap-2">
              <% Category.roots.visible.each do |category| %>
                <%= link_to category.localized_name, category_path(category), class: "flex items-center justify-between py-4 px-5 text-sm font-bold text-slate-900 bg-slate-50 rounded-2xl hover:bg-accent hover:text-white transition-all" %>
              <% end %>
            </div>
          </div>
          
          <div class="pt-8 border-t border-slate-100">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] block mb-6">Quick Access</span>
            <div class="space-y-4">
              <%= link_to t('navbar.home'), root_path, class: "block text-lg font-black text-slate-900" %>
              <%= link_to t('navbar.factory'), factory_path, class: "block text-lg font-black text-slate-900" %>
              <%= link_to t('navbar.blog'), posts_path, class: "block text-lg font-black text-slate-900" %>
              <%= link_to t('navbar.contact_us'), contact_path, class: "block text-lg font-black text-slate-900" %>
            </div>
          </div>

          <div class="pt-8 border-t border-slate-100 pb-20">
            <div class="bg-primary rounded-3xl p-6 text-white">
              <h4 class="text-lg font-black mb-2">Ready to Start?</h4>
              <p class="text-slate-300 text-sm mb-6">Get a professional kitchen solution for your project.</p>
              <%= link_to contact_path, class: "block w-full py-4 bg-accent text-center font-black rounded-2xl shadow-lg shadow-accent/20" do %>
                REQUEST A QUOTE
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
  <!-- Spacer to prevent content jump -->
  <div class="h-[72px] md:h-[120px]"></div>
</div>
