<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || @site_config.meta_title.presence || @site_config.name %></title>
    <meta name="description" content="<%= content_for(:meta_description) || @site_config.meta_description.presence || "Sinower is a professional commercial kitchen equipment manufacturer based in Shandong, China, with 20 years of manufacturing experience." %>">
    <meta name="keywords" content="<%= content_for(:meta_keywords) || @site_config.meta_keywords.presence || "commercial kitchen equipment, refrigeration equipment, cooking equipment, foodservice equipment manufacturer, Sinower Kitchen" %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>


    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "logo.png" %>
    <%= favicon_link_tag "logo.png", rel: "apple-touch-icon" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style> 
      [x-cloak] { display: none !important; } 
      /* Hide number input spinners for Chrome, Safari, Edge, Opera */
      input::-webkit-outer-spin-button,
      input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
      /* Hide number input spinners for Firefox */
      input[type=number] {
        -moz-appearance: textfield;
      }
    </style>
  </head>

  <body class="flex flex-col min-h-screen bg-white" x-data="{ scrolled: false }" @scroll.window="scrolled = (window.pageYOffset > 50)">
    <%= render "layouts/navbar" %>
    
    <main class="flex-grow">
      <% if notice %>
        <div class="max-w-screen-xl mx-auto px-5 mt-4">
          <p class="p-4 text-sm text-blue-800 rounded-lg bg-blue-50 border border-blue-100" role="alert"><%= notice %></p>
        </div>
      <% end %>
      <% if alert %>
        <div class="max-w-screen-xl mx-auto px-5 mt-4">
          <p class="p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-100" role="alert"><%= alert %></p>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Floating Contact Sidebar -->
    <div class="fixed right-5 top-1/2 -translate-y-1/2 z-50 flex flex-col gap-3">
      <% [
           { href: "tel:+86 0543 8171612", title: "+86 0543 8171612", bg: "from-teal-500 to-teal-600", shadow: "shadow-teal-500/40", icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>', stroke: true, target: "_self" },
           {
             href: "https://wa.me/393337403467",
             title: "+39 333 740 3467",
             bg: "from-green-500 to-emerald-600",
             shadow: "shadow-green-500/40",
             icon: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>',
             stroke: false,
             target: "_blank"
           },
           {
             href: "mailto:info@skyrainbow.com.cn",
             title: "info@skyrainbow.com.cn",
             bg: "from-blue-500 to-indigo-600",
             shadow: "shadow-blue-500/40",
             icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
             stroke: true,
             target: "_blank"
           },
           {
             href: "#",
             title: "WeChat",
             bg: "from-green-400 to-green-500",
             shadow: "shadow-green-400/40",
             icon: '<path d="M8.5 4C4.9 4 2 6.4 2 9.3c0 1.7 1 3.2 2.5 4.2L4 16l3-1.5c.5.1 1 .2 1.5.2-.2-.6-.3-1.2-.3-1.8 0-3.2 3-5.8 6.7-5.8.3 0 .6 0 .9.1C14 5.8 11.5 4 8.5 4zm6.5 5.5c-3 0-5.5 1.9-5.5 4.3s2.5 4.3 5.5 4.3c.5 0 1-.1 1.5-.2l2.5 1.2-.5-2c1.2-.8 2-1.9 2-3.3 0-2.4-2.5-4.3-5.5-4.3z"/>',
             stroke: false,
             target: "_self",
             wechat: true
           }
         ].each do |item| %>
        <div class="group flex items-center justify-end">
          <!-- Tooltip label -->
          <span class="fsb-label mr-3 px-3 py-1.5 bg-slate-900 text-white text-xs font-bold rounded-xl whitespace-nowrap shadow-lg opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0">
            <%= item[:title] %>
          </span>
          <!-- Icon button -->
          <a
            href="<%= item[:wechat] ? 'javascript:void(0)' : item[:href] %>"
            target="<%= item[:target] %>"
            <% if item[:wechat] %>
            onclick="openWechat()"
            <% end %>
            class="w-12 h-12 rounded-2xl bg-gradient-to-br <%= item[:bg] %> flex items-center justify-center text-white shadow-lg <%= item[:shadow] %> hover:scale-110 hover:rounded-xl transition-all duration-300 flex-shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="<%= item[:stroke] ? 'none' : 'currentColor' %>" stroke="<%= item[:stroke] ? 'currentColor' : 'none' %>">
              <%= item[:icon].html_safe %>
            </svg>
          </a>
        </div>
      <% end %>
    </div>

    <!-- Cart / Inquiry Floating Button (Professional Industrial Style) -->
    <div class="fixed right-6 bottom-6 z-50 group">
        <button onclick="document.getElementById('cartModal').classList.remove('hidden'); loadCart();"
                class="relative flex flex-col items-center justify-center w-24 h-24 bg-slate-900 text-white rounded-3xl shadow-[0_20px_50px_-15px_rgba(0,0,0,0.5)] hover:shadow-orange-500/30 transition-all duration-500 hover:-translate-y-3 active:scale-95 group overflow-hidden border border-white/10">
          
          <!-- Industrial Texture / Background Gradient -->
          <div class="absolute inset-0 bg-gradient-to-br from-slate-800 to-slate-900 opacity-100"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-orange-500/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          
          <!-- Top Accent Line -->
          <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-orange-500 via-orange-400 to-orange-600 shadow-[0_2px_10px_rgba(249,115,22,0.4)]"></div>

          <!-- Icon & Badge Container -->
          <div class="relative z-10 mb-2 mt-2 transform group-hover:scale-110 transition-transform duration-500">
            <!-- List Icon instead of simple Cart -->
            <svg class="w-9 h-9 text-orange-500 group-hover:text-orange-400 transition-colors duration-300 drop-shadow-[0_0_12px_rgba(249,115,22,0.4)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
            </svg>
            
            <!-- Dynamic Counter Badge -->
            <span id="cartCountBadge" class="absolute -top-1.5 -right-2.5 bg-red-600 text-white text-[10px] font-black w-5 h-5 flex items-center justify-center rounded-lg border-2 border-slate-900 shadow-xl transform rotate-3 hidden">0</span>
          </div>

          <!-- Label -->
          <div class="relative z-10 flex flex-col items-center">
            <span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-500 group-hover:text-orange-400 transition-colors duration-300 mb-0.5">
              Inquiry
            </span>
            <span class="text-[11px] font-black uppercase tracking-widest text-white">
              List
            </span>
          </div>

          <!-- Scanning/Light Effect -->
          <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
        </button>
        
        <!-- Ambient Pulse -->
        <div class="absolute -inset-2 bg-orange-500/10 rounded-[2rem] blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"></div>
    </div>

    <!-- WeChat Popup -->
    <div id="wechatModal"
         class="fixed inset-0 bg-black/50 z-[999] hidden items-center justify-center"
         onclick="closeWechat()">

      <div class="bg-white rounded-3xl p-5 shadow-2xl"
           onclick="event.stopPropagation()">

        <img src="<%= asset_path('logo.png') %>"
             class="w-72 h-72 object-contain rounded-xl">

        <p class="text-center mt-3 font-bold text-gray-700">
          Scan WeChat QR Code
        </p>

      </div>

    </div>


    <script>
        function openWechat(){
            const box = document.getElementById("wechatModal");
            box.classList.remove("hidden");
            box.classList.add("flex");
        }

        function closeWechat(){
            const box = document.getElementById("wechatModal");
            box.classList.add("hidden");
            box.classList.remove("flex");
        }
        
        function addToOrder(skuId) {
            fetch('/order/add_item', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              },
              body: JSON.stringify({ sku_id: skuId })
            })
            .then(response => response.json())
            .then(data => {
              showToast('Success', 'Added to Order List');
              updateCartBadge();
            });
        }

        function showToast(title, message) {
            // Create toast element if it doesn't exist
            let toast = document.getElementById('sinowerToast');
            if (!toast) {
              toast = document.createElement('div');
              toast.id = 'sinowerToast';
                toast.className = 'fixed top-24 right-5 z-[100] transform transition-all duration-500 translate-x-full';
                document.body.appendChild(toast);
            }
            
            toast.innerHTML = `
                <div class="bg-slate-900 border-l-4 border-orange-500 text-white px-6 py-4 rounded-xl shadow-2xl flex items-center gap-4 min-w-[300px]">
                    <div class="bg-orange-500/20 p-2 rounded-lg">
                        <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="font-bold text-sm">${title}</p>
                        <p class="text-xs text-slate-400">${message}</p>
                    </div>
                </div>
            `;
            
            // Show
            setTimeout(() => toast.classList.remove('translate-x-full'), 100);
            
            // Hide
            setTimeout(() => {
                toast.classList.add('translate-x-full');
            }, 3000);
        }

        function loadCart() {
          fetch('/order/cart_items')
            .then(response => response.json())
            .then(data => {
              const container = document.getElementById('cartItems');
              container.innerHTML = data.items.map(item => `
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 p-4 bg-gray-50 rounded-2xl border border-gray-100 gap-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary flex-shrink-0">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 7h-3V5a2 2 0 00-2-2H8a2 2 0 00-2 2v2H3a1 1 0 00-1 1v11a2 2 0 002 2h16a2 2 0 002-2V8a1 1 0 00-1-1zM8 5h8v2H8V5z"></path></svg>
                    </div>
                    <span class="font-bold text-gray-800">${item.name}</span>
                  </div>
                  
                  <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
                    <div class="flex items-center bg-white rounded-xl border border-gray-200 p-1 shadow-sm">
                      <button onclick="decrementQuantity(${item.id}, ${item.quantity})" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/5 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                      </button>
                      <input type="number" value="${item.quantity}" min="1" 
                        class="w-12 border-none bg-transparent p-0 text-center text-sm font-bold text-gray-700 focus:ring-0" 
                        onchange="updateCartQuantity(${item.id}, this.value)">
                      <button onclick="incrementQuantity(${item.id}, ${item.quantity})" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/5 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                      </button>
                    </div>
                    
                    <button onclick="removeFromCart(${item.id})" class="p-2 text-gray-400 hover:text-red-500 transition-colors">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                  </div>
                </div>
              `).join('');
              updateCartBadge(data.items.length);
            });
        }

        function incrementQuantity(skuId, currentQty) {
          updateCartQuantity(skuId, parseInt(currentQty) + 1);
        }

        function decrementQuantity(skuId, currentQty) {
          const newQty = Math.max(1, parseInt(currentQty) - 1);
          updateCartQuantity(skuId, newQty);
        }

        function updateCartQuantity(skuId, quantity) {
            quantity = parseInt(quantity);
            if (isNaN(quantity) || quantity < 1) quantity = 1;
            
            fetch('/order/update_item', {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              },
              body: JSON.stringify({ sku_id: skuId, quantity: quantity })
            })
            .then(response => response.json())
            .then(data => {
              loadCart();
              updateCartBadge();
            });
        }

        function removeFromCart(skuId) {
            fetch('/order/remove_item', {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              },
              body: JSON.stringify({ sku_id: skuId })
            })
            .then(response => response.json())
            .then(data => {
              loadCart();
              updateCartBadge();
            });
        }
        
        function updateCartBadge(count) {
            const badge = document.getElementById('cartCountBadge');
            if (count === undefined) {
                fetch('/order/cart_items')
                .then(response => response.json())
                .then(data => {
                    updateCartBadge(data.items.length);
                });
                return;
            }
            if (count > 0) {
                badge.innerText = count;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }
        
        // Initial load
        document.addEventListener('turbo:load', () => {
            updateCartBadge();
        });
        document.addEventListener('DOMContentLoaded', () => {
            updateCartBadge();
        });
    </script>

    <%= render "layouts/footer" %>
    <%= render "shared/privacy_modal" %>
    <%= render "shared/cart_modal" %>

    <!-- IP Tracking Consent Banner -->
    <div x-data="{ 
           showBanner: !localStorage.getItem('ip_consent_handled'),
           handleConsent(allowed) {
             const expiry = new Date();
             expiry.setFullYear(expiry.getFullYear() + 1);
             document.cookie = `ip_tracking_allowed=${allowed}; expires=${expiry.toUTCString()}; path=/; SameSite=Lax`;
             localStorage.setItem('ip_consent_handled', 'true');
             this.showBanner = false;
             if (!allowed) {
               console.log('IP tracking declined by user');
             }
           }
         }"
         x-show="showBanner"
         x-transition:enter="transition ease-out duration-500"
         x-transition:enter-start="opacity-0 translate-y-full"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-full"
         class="fixed bottom-0 inset-x-0 z-[60] p-4 sm:p-6"
         x-cloak>
      <div class="max-w-7xl mx-auto bg-slate-900/95 backdrop-blur-md rounded-[2rem] shadow-2xl border border-white/10 overflow-hidden">
        <div class="p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex-1 text-center md:text-left">
            <h4 class="text-xl font-black text-white mb-2 tracking-tight">
              <%= t('privacy_policy.ip_banner.title') %>
            </h4>
            <p class="text-slate-300 text-sm font-medium leading-relaxed max-w-2xl">
              <%= t('privacy_policy.ip_banner.content') %>
              <button @click="$dispatch('open-privacy')" class="text-white underline hover:text-blue-400 transition-colors ml-1">
                <%= t('privacy_policy.ip_banner.learn_more') %>
              </button>
            </p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
            <button @click="handleConsent(false)" 
                    class="px-6 py-3 text-slate-300 hover:text-white text-sm font-bold transition-colors">
              <%= t('privacy_policy.ip_banner.decline') %>
            </button>
            <button @click="handleConsent(true)" 
                    class="px-8 py-3 bg-white text-slate-900 hover:bg-slate-100 rounded-2xl text-sm font-black transition-all shadow-lg shadow-white/5">
              <%= t('privacy_policy.ip_banner.accept') %>
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
