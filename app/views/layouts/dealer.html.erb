<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <title><%= content_for(:title) || "Sinower 经销商服务平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  <body class="bg-slate-50 font-sans antialiased text-slate-900" x-data="{ sidebarOpen: false }">
    <div class="flex min-h-screen">
      <%# Sidebar %>
      <%= render "dealer/shared/sidebar" %>

      <%# Main Content Area %>
      <div class="flex-grow flex flex-col min-w-0">
        <%# Dealer Navbar %>
        <header class="bg-white border-b border-slate-200 sticky top-0 z-20">
          <div class="px-6 md:px-8 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <button @click="sidebarOpen = !sidebarOpen" class="md:hidden p-2 text-slate-600 hover:text-slate-900 rounded-lg">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
              </button>
              <h1 class="text-lg md:text-xl font-black text-slate-800"><%= content_for(:dealer_title) || "经销商服务中心" %></h1>
            </div>
            
            <div class="flex items-center space-x-4 md:space-x-6">
              <div class="hidden sm:flex items-center space-x-2">
                <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                  <%= current_user.display_name.first.upcase %>
                </div>
                <div class="text-left">
                  <div class="text-xs font-bold text-slate-800"><%= current_user.display_name %></div>
                  <div class="text-[10px] text-slate-400"><%= current_user.email %></div>
                </div>
              </div>

              <%= link_to root_path, class: "text-xs font-bold text-slate-600 hover:text-primary transition-colors flex items-center" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                <span class="hidden sm:inline">商城首页</span>
              <% end %>

              <%= button_to destroy_user_session_path, method: :delete, class: "text-xs font-bold text-red-600 hover:text-red-800 transition-colors" do %>
                退出
              <% end %>
            </div>
          </div>
        </header>

        <%# Page Content %>
        <main class="p-4 md:p-8 flex-grow">
          <% if notice %>
            <div class="p-4 mb-6 text-sm text-blue-900 rounded-2xl bg-blue-50 border border-blue-100 flex items-center" role="alert">
              <svg class="w-5 h-5 mr-3 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span><%= notice %></span>
            </div>
          <% end %>
          <% if alert %>
            <div class="p-4 mb-6 text-sm text-amber-900 rounded-2xl bg-amber-50 border border-amber-100 flex items-center" role="alert">
              <svg class="w-5 h-5 mr-3 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              <span><%= alert %></span>
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
