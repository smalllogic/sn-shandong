<% content_for :title, @post.localized_meta_title.presence || "#{@post.localized_title} - #{t('posts.hero.title')}" %>
<% content_for :meta_description, @post.localized_meta_description.presence || @post.localized_summary %>
<% if @post.localized_meta_keywords.present? %>
  <% content_for :meta_keywords, @post.localized_meta_keywords %>
<% end %>

<div class="max-w-screen-lg mx-auto px-6 py-16">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-400 mb-10">
    <%= link_to posts_path, class: "hover:text-primary transition-colors font-medium" do %>
      <%= t("posts.#{@post.category}.title") %>
    <% end %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-slate-600 font-medium truncate"><%= @post.localized_title %></span>
  </nav>

  <!-- Article header -->
  <header class="mb-10">
    <div class="flex items-center gap-3 mb-5">
      <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full uppercase tracking-widest">
        <%= t('posts.show.badge') %>
      </span>
      <span class="text-xs text-slate-400 font-medium"><%= l(@post.published_at.to_date, format: :long) if @post.published_at.present? %></span>
      <span class="text-slate-200">|</span>
      <span class="flex items-center gap-1 text-xs text-slate-400 font-medium">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
        <%= number_with_delimiter(@post.views_count) %>
      </span>
    </div>
    <h1 class="text-4xl md:text-5xl font-black text-slate-900 leading-tight tracking-tight mb-6"><%= @post.localized_title %></h1>
    <% if @post.localized_summary.present? %>
      <p class="text-xl text-slate-500 font-medium leading-relaxed border-l-4 border-primary pl-6 py-1"><%= @post.localized_summary %></p>
    <% end %>
  </header>

  <!-- Cover image -->
  <% if @post.cover_image.attached? %>
    <div class="mb-12 rounded-[2.5rem] overflow-hidden shadow-xl border border-slate-100 aspect-[16/7]">
      <%= image_tag @post.cover_image.variant(:large), class: "w-full h-full object-cover", alt: @post.localized_title %>
    </div>
  <% end %>

  <!-- Rich text content -->
  <div class="prose prose-slate prose-lg max-w-none
    prose-headings:font-black prose-headings:text-slate-900 prose-headings:tracking-tight
    prose-p:text-slate-600 prose-p:leading-relaxed
    prose-a:text-primary prose-a:no-underline hover:prose-a:underline
    prose-img:rounded-2xl prose-img:shadow-lg
    prose-blockquote:border-l-primary prose-blockquote:bg-slate-50 prose-blockquote:rounded-r-2xl prose-blockquote:py-2 prose-blockquote:pr-4
    prose-strong:text-slate-800
    prose-li:text-slate-600">
    <%= @post.localized_content %>
  </div>

  <!-- Back link -->
  <div class="mt-16 pt-8 border-t border-slate-100">
    <%= link_to posts_path, class: "inline-flex items-center gap-2 text-slate-500 hover:text-primary font-semibold text-sm transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <%= t('posts.back_to_blog') %>
    <% end %>
  </div>
</div>
