<section aria-labelledby="sku-configuration-heading" class="mb-8 space-y-4 rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5">
  <h2 id="sku-configuration-heading" class="text-lg font-bold text-slate-900"><%= t("sku_configurations.title") %></h2>
  <% groups.each do |group| %>
    <fieldset class="min-w-0">
      <legend class="mb-2 text-sm font-semibold text-slate-900"><%= group.localized_name %></legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <label class="flex min-w-0 cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 has-checked:border-primary has-checked:bg-primary/5 focus-within:ring-2 focus-within:ring-primary">
          <%= radio_button_tag "configuration_group_#{group.id}", "", true,
            data: { sku_configurator_target: "option", action: "change->sku-configurator#refresh" },
            class: "shrink-0 accent-primary" %>
          <span class="min-w-0 break-words text-sm leading-snug">
            <span class="block font-semibold text-slate-900"><%= t("sku_configurations.standard") %></span>
            <span class="block text-xs text-slate-700"><%= t("sku_configurations.no_surcharge") %></span>
          </span>
        </label>
        <% group.available_options.each do |option| %>
          <div class="flex min-w-0 items-center gap-2 rounded-lg border border-slate-200 bg-white p-2.5 has-checked:border-primary has-checked:bg-primary/5 focus-within:ring-2 focus-within:ring-primary">
            <% if option.image.attached? && option.image.variable? %>
              <% description = "#{group.localized_name} · #{option.localized_name}" %>
              <% preview_label = t("sku_configurations.preview_image", name: description) %>
              <button type="button" class="relative size-12 shrink-0 cursor-zoom-in overflow-hidden rounded-md border border-slate-200 bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:border-primary"
                      aria-label="<%= preview_label %>" title="<%= preview_label %>" aria-controls="sku-main-gallery" aria-pressed="false"
                      data-sku-gallery-target="option"
                      data-action="sku-gallery#showConfiguration"
                      data-image-url="<%= url_for(option.image.variant(:large)) %>"
                      data-image-description="<%= description %>">
                <%= image_tag option.image.variant(:thumb), alt: "", width: 48, height: 48,
                    loading: "lazy", decoding: "async", class: "size-full object-cover" %>
                <span class="absolute bottom-0.5 right-0.5 grid size-4 place-items-center rounded-sm bg-slate-900/80 text-white" aria-hidden="true">
                  <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6" stroke-width="2"/><path d="m15 15 5 5m-9.5-12v5M8 10.5h5" stroke-linecap="round" stroke-width="2"/></svg>
                </span>
              </button>
            <% end %>
            <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-2 py-1">
              <%= radio_button_tag "configuration_group_#{group.id}", option.id, false,
                data: { sku_configurator_target: "option", action: "change->sku-configurator#refresh",
                        surcharge_cents: ((option.surcharge * 100).to_i unless option.surcharge.nil?), currency: group.currency },
                class: "shrink-0 accent-primary" %>
              <span class="min-w-0 break-words text-sm leading-snug">
                <span class="block font-semibold text-slate-900"><%= option.localized_name %></span>
                <% if option.model_code.present? %><span class="block text-xs text-slate-600"><%= option.model_code %></span><% end %>
                <span class="block text-xs text-slate-700">
                  <% if option.surcharge.nil? %>
                    <%= t("sku_configurations.quote") %>
                  <% elsif option.surcharge.zero? %>
                    <%= t("sku_configurations.no_surcharge") %>
                  <% else %>
                    + <%= format_configuration_money(option.surcharge, group.currency) %>
                  <% end %>
                </span>
              </span>
            </label>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <div class="flex flex-wrap justify-between gap-2 border-t border-slate-200 pt-3 text-sm">
    <span class="font-semibold text-slate-900"><%= t("sku_configurations.per_unit") %></span>
    <output data-sku-configurator-target="total" aria-live="polite" class="font-bold text-slate-900"><%= t("sku_configurations.no_surcharge") %></output>
  </div>
</section>
