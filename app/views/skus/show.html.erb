<% 
  content_for :title, @sku.meta_title.presence || "#{@sku.name} - #{t('home.index.hero_title_2')}"
  content_for :meta_description, @sku.meta_description.presence || "#{@sku.name} - Professional #{@sku.category.localized_name} for commercial kitchen and foodservice. OEM & ODM available. Factory-direct pricing from Sinower."
  content_for :meta_keywords, @sku.meta_keywords.presence || "#{@sku.name}, #{@sku.category.localized_name}, commercial kitchen equipment, foodservice equipment, restaurant equipment, Sinower Kitchen"
%>
<div class="max-w-screen-xl mx-auto px-4 py-12">
  <!-- 顶部面包屑导航 -->
  <nav class="flex mb-10 items-center space-x-0 text-[10px] font-black uppercase tracking-[0.2em] bg-white text-slate-900 p-0 rounded-lg overflow-hidden w-fit sticky top-20 z-10 shadow-sm border border-slate-200">
    <% @sku.category.ancestors_and_self.each do |cat| %>
      <%= link_to cat.localized_name, categories_path(category_id: cat), class: "px-4 py-2.5 hover:bg-slate-50 hover:text-primary transition-colors border-r border-slate-100" %>
    <% end %>
    <span class="px-4 py-2.5 bg-slate-50 text-slate-400 truncate max-w-[200px]"><%= @sku.name %></span>
  </nav>

  <!-- 产品主展示区：工业风布局 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 bg-white rounded-xl border border-slate-200 shadow-xl overflow-hidden relative">
    
    <!-- 左侧：媒体展示 (占 5/12) -->
    <div class="lg:col-span-5 relative border-r border-slate-100 bg-slate-50/30" 
         x-data="{ 
           activeImage: 0, 
           isZoomed: false, 
           zoomX: 0, 
           zoomY: 0,
           handleMouseMove(e) {
             const rect = e.currentTarget.getBoundingClientRect();
             this.zoomX = ((e.clientX - rect.left) / rect.width) * 100;
             this.zoomY = ((e.clientY - rect.top) / rect.height) * 100;
           }
         }">
      <div class="p-8">
        <div class="bg-white rounded-lg border border-slate-100 shadow-sm overflow-hidden group relative">
          <div class="aspect-square relative overflow-hidden bg-white"
               :class="isZoomed ? 'cursor-zoom-out' : 'cursor-zoom-in'"
               @mouseenter="isZoomed = true"
               @mouseleave="isZoomed = false"
               @mousemove="handleMouseMove($event)">
            <% if @sku.images.attached? %>
              <% @sku.sorted_images.each_with_index do |image, index| %>
                <div x-show="activeImage === <%= index %>" 
                     x-cloak
                     x-transition:enter="transition opacity duration-300"
                     class="w-full h-full absolute inset-0">
                  <%= image_tag image, 
                                class: "w-full h-full object-contain p-6", 
                                style: "background-color: transparent;",
                                loading: index == 0 ? "eager" : "lazy" %>
                  
                  <!-- 放大镜层 -->
                  <div x-show="isZoomed"
                       class="absolute inset-0 z-20 pointer-events-none"
                       :style="`background-image: url('${activeImage === <%= index %> ? url_for(image).html_safe : ''}'); 
                                background-size: 250%; 
                                background-position: ${zoomX}% ${zoomY}%; 
                                background-repeat: no-repeat;`"
                       x-transition:enter="transition opacity duration-200"
                       x-transition:enter-start="opacity-0"
                       x-transition:enter-end="opacity-100">
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="w-full h-full flex flex-col items-center justify-center">
                <svg class="w-24 h-24 text-slate-100 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">Digital Asset Pending</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- 缩略图列表 -->
        <% if @sku.images.attached? && @sku.images.count > 1 %>
          <div class="flex flex-wrap gap-3 mt-6">
            <% @sku.sorted_images.each_with_index do |image, index| %>
              <button @click="activeImage = <%= index %>" 
                      :class="activeImage === <%= index %> ? 'border-primary' : 'border-slate-200'"
                      class="w-16 h-16 rounded border bg-white overflow-hidden transition-all group">
                <%= image_tag image.variant(resize_to_limit: [100, 100]), class: "w-full h-full object-contain p-1 group-hover:scale-110 transition-transform" %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 右侧：产品详情信息 (工业风) -->
    <div class="lg:col-span-7 flex flex-col bg-white p-10 lg:p-14">
      <div class="mb-auto">
        <div class="flex items-center space-x-4 mb-8">
          <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.4em] border-l-4 border-primary pl-4">Engineering Excellence</span>
        </div>
        
        <h1 class="text-4xl lg:text-5xl font-black text-slate-900 mb-8 tracking-tight leading-none uppercase"><%= @sku.name %></h1>
        
        <div class="grid grid-cols-2 gap-8 mb-12">
          <div class="border-l border-slate-100 pl-4">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Product Status</p>
            <p class="text-sm font-black text-slate-900 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
              Active Production
            </p>
          </div>
          <div class="border-l border-slate-100 pl-4">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Global Standard</p>
            <p class="text-sm font-black text-slate-900 uppercase">CE / RoHS / ISO</p>
          </div>
        </div>
      </div>

      <!-- 操作区域 -->
      <div class="space-y-6 pt-10 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row gap-4">
          <button onclick="addToOrder(<%= @sku.id %>)" class="flex-1 inline-flex justify-center items-center px-8 py-4 bg-slate-900 hover:bg-primary text-white font-black text-xs tracking-widest uppercase transition-all duration-300 group">
            <span>Add to Quote Request</span>
            <svg class="w-4 h-4 ml-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </div>
        <div class="flex items-center justify-between text-[10px] text-slate-400 font-bold uppercase tracking-wider">
          <span>Model: SNW-<%= @sku.id.to_s.rjust(6, '0') %></span>
          <span>Lead Time: 15-30 Days</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 下方：详细特性 (工业风) -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl p-10 border border-slate-200 shadow-sm h-full">
        <div class="flex items-center justify-between mb-10 border-b border-slate-100 pb-6">
          <h3 class="text-lg font-black text-slate-900 tracking-[0.1em] uppercase"><%= t('skus.standard_features') %></h3>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest italic">Technical Specifications</span>
        </div>
        <div class="prose prose-slate max-w-none text-slate-600 font-medium">
          <% if @sku.standard_features.present? %>
            <%= @sku.standard_features %>
          <% else %>
            <p class="italic text-slate-400"><%= t('skus.default_feature_desc') %></p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="lg:col-span-1">
      <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm h-full flex flex-col bg-white">
        <!-- Technical Contact Header -->
        <div class="bg-slate-900 p-8 text-center relative overflow-hidden">
          <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(30deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(150deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(30deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(150deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(60deg, #999 25%, transparent 25.5%, transparent 75%, #999 75%, #999), linear-gradient(60deg, #999 25%, transparent 25.5%, transparent 75%, #999 75%, #999); background-size: 40px 70px;"></div>
          <h3 class="text-white font-black text-lg relative z-10 tracking-widest uppercase mb-1">Global Support</h3>
          <p class="text-primary text-[10px] font-black uppercase tracking-[0.3em] relative z-10">Sales & Engineering</p>
        </div>
        <!-- Contact body -->
        <div class="p-8 flex flex-col gap-6">
          <p class="text-slate-500 text-xs font-bold leading-relaxed uppercase tracking-wide">Direct channel for wholesale, OEM projects and technical verification.</p>
          
          <div class="space-y-4">
            <a href="https://wa.me/+8605438171612" target="_blank" class="flex items-center gap-4 p-4 border border-slate-100 hover:border-primary/30 transition-all group">
              <div class="w-10 h-10 bg-slate-50 flex items-center justify-center text-slate-400 group-hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">WhatsApp Business</p>
                <p class="text-xs font-black text-slate-900">+86 186 6303 1612</p>
              </div>
            </a>
            
            <a href="mailto:info@skyrainbow.com.cn" class="flex items-center gap-4 p-4 border border-slate-100 hover:border-primary/30 transition-all group">
              <div class="w-10 h-10 bg-slate-50 flex items-center justify-center text-slate-400 group-hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Global Inquiry</p>
                <p class="text-xs font-black text-slate-900">info@skyrainbow.com.cn</p>
              </div>
            </a>
          </div>

          <%= link_to contact_path, class: "mt-4 block w-full text-center py-4 bg-primary text-white font-black text-[10px] tracking-[0.2em] uppercase transition-all shadow-lg shadow-primary/20 hover:scale-[1.02]" do %>
            Request Factory Quote
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- 推荐产品 (工业风) -->
  <%
    all_in_cat = @sku.category.skus.where(status: 'active').order(position: :asc, created_at: :desc).to_a
    cur_idx    = all_in_cat.index { |s| s.id == @sku.id }
    related    = []
    if cur_idx
      # 获取前后各几个
      related << all_in_cat[cur_idx - 1] if cur_idx > 0
      related << all_in_cat[cur_idx + 1] if cur_idx + 1 < all_in_cat.length
      related << all_in_cat[cur_idx + 2] if cur_idx + 2 < all_in_cat.length
      # 如果不够 3 个，尝试从头部补
      if related.length < 3
        all_in_cat.each do |s|
          next if s.id == @sku.id || related.include?(s)
          related << s
          break if related.length >= 4
        end
      end
    end
    related.compact!
  %>
  <% if related.any? %>
    <div class="mt-20">
      <div class="flex items-center justify-between mb-10 border-b border-slate-100 pb-6">
        <h2 class="text-xl font-black text-slate-900 tracking-widest uppercase">Related Equipment</h2>
        <div class="flex space-x-1">
          <div class="w-12 h-1 bg-primary"></div>
          <div class="w-4 h-1 bg-slate-200"></div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% related.take(4).each do |s| %>
          <%= link_to sku_path(s), class: "group bg-white border border-slate-200 hover:border-primary transition-all duration-300 flex flex-col h-full" do %>
            <div class="aspect-square overflow-hidden bg-slate-50 border-b border-slate-100">
              <% if s.images.attached? %>
                <% begin %>
                  <%= image_tag s.sorted_images.first.variant(resize_to_limit: [600, 600]),
                                class: "w-full h-full object-contain p-6 group-hover:scale-110 transition-transform duration-500" %>
                <% rescue %>
                  <div class="w-full h-full flex items-center justify-center text-slate-200">No Image</div>
                <% end %>
              <% end %>
            </div>
            <div class="p-6 bg-white">
              <p class="text-[8px] font-black text-primary uppercase tracking-[0.2em] mb-2"><%= s.category.localized_name %></p>
              <h3 class="font-black text-slate-900 text-xs leading-tight uppercase group-hover:text-primary transition-colors line-clamp-2"><%= s.name %></h3>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
