<% 
  content_for :title, @sku.localized_meta_title.presence || "#{@sku.localized_name} - #{t('home.index.hero_title_2')}"
  content_for :meta_description, @sku.localized_meta_description.presence || t('skus.meta_description', name: @sku.localized_name, category: @sku.category.localized_name)
  content_for :meta_keywords, @sku.localized_meta_keywords.presence || t('skus.meta_keywords', name: @sku.localized_name, category: @sku.category.localized_name)
%>
<div class="max-w-screen-xl mx-auto px-4 py-12">
  <!-- 顶部面包屑导航 -->
  <nav class="flex mb-10 items-center space-x-0 text-[10px] font-black uppercase tracking-[0.2em] bg-white text-slate-900 p-0 rounded-lg overflow-hidden w-fit sticky top-20 z-10 shadow-sm border border-slate-200">
    <% @sku.category.ancestors_and_self.each do |cat| %>
      <%= link_to cat.localized_name, categories_path(category_id: cat), class: "px-4 py-2.5 hover:bg-slate-50 hover:text-primary transition-colors border-r border-slate-100" %>
    <% end %>
    <span class="px-4 py-2.5 bg-slate-50 text-slate-400 truncate max-w-[200px]"><%= @sku.localized_name %></span>
  </nav>

  <!-- 产品主展示区：工业风布局 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 bg-white rounded-xl border border-slate-200 shadow-xl overflow-hidden relative">
    
    <!-- 左侧：媒体展示 (占 5/12) -->
    <div class="lg:col-span-5 relative border-r border-slate-100 bg-slate-50/30" 
         x-data="{ 
           activeImage: 0, 
           isZoomed: false, 
           zoomX: 0, 
           zoomY: 0,
           handleMouseMove(e) {
             const rect = e.currentTarget.getBoundingClientRect();
             this.zoomX = ((e.clientX - rect.left) / rect.width) * 100;
             this.zoomY = ((e.clientY - rect.top) / rect.height) * 100;
           }
         }">
      <div class="p-8">
        <div class="bg-white rounded-lg border border-slate-100 shadow-sm overflow-hidden group relative">
          <div class="aspect-square relative overflow-hidden bg-white"
               :class="isZoomed ? 'cursor-zoom-out' : 'cursor-zoom-in'"
               @mouseenter="isZoomed = true"
               @mouseleave="isZoomed = false"
               @mousemove="handleMouseMove($event)">
            <% if @sku.images.attached? %>
              <% @sku.sorted_images.each_with_index do |image, index| %>
                <div x-show="activeImage === <%= index %>" 
                     x-cloak
                     x-transition:enter="transition opacity duration-300"
                     class="w-full h-full absolute inset-0">
                  <%= image_tag image, 
                                class: "w-full h-full object-contain p-6", 
                                style: "background-color: transparent;",
                                loading: index == 0 ? "eager" : "lazy" %>
                  
                  <!-- 放大镜层 -->
                  <div x-show="isZoomed"
                       class="absolute inset-0 z-20 pointer-events-none"
                       :style="`background-image: url('${activeImage === <%= index %> ? url_for(image).html_safe : ''}'); 
                                background-size: 250%; 
                                background-position: ${zoomX}% ${zoomY}%; 
                                background-repeat: no-repeat;`"
                       x-transition:enter="transition opacity duration-200"
                       x-transition:enter-start="opacity-0"
                       x-transition:enter-end="opacity-100">
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="w-full h-full flex flex-col items-center justify-center">
                <svg class="w-24 h-24 text-slate-100 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest"><%= t('skus.digital_asset_pending') %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- 缩略图列表 -->
        <% if @sku.images.attached? && @sku.images.count > 1 %>
          <div class="flex flex-wrap gap-3 mt-6">
            <% @sku.sorted_images.each_with_index do |image, index| %>
              <button @click="activeImage = <%= index %>" 
                      :class="activeImage === <%= index %> ? 'border-primary' : 'border-slate-200'"
                      class="w-16 h-16 rounded border bg-white overflow-hidden transition-all group">
                <%= image_tag image.variant(resize_to_limit: [100, 100]), class: "w-full h-full object-contain p-1 group-hover:scale-110 transition-transform" %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 右侧：产品详情信息 (工业风) -->
    <div class="lg:col-span-7 flex flex-col bg-white p-8 lg:p-14 lg:pl-16">
      <div class="mb-auto">
        <div class="flex flex-col mb-10">
          <h1 class="text-4xl lg:text-6xl font-black text-slate-900 tracking-tighter leading-none uppercase mb-6"><%= @sku.localized_name %></h1>
          <div class="w-20 h-2 bg-primary"></div>
        </div>
        
        <!-- Specifications Detail -->
        <% specs = @sku.localized_specifications %>
        <% if specs.any? %>
          <div class="mb-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% specs.each do |spec| %>
                <div class="group relative flex flex-col justify-center bg-slate-50/40 hover:bg-white p-5 rounded-lg border border-slate-100/50 hover:border-primary/20 hover:shadow-xl hover:shadow-slate-200/40 transition-all duration-500 overflow-hidden">
                  <!-- 背景装饰线 -->
                  <div class="absolute left-0 top-0 bottom-0 w-1 bg-slate-200 group-hover:bg-primary transition-colors duration-500"></div>
                  
                  <div class="flex items-center justify-between">
                    <div class="flex flex-col">
                      <span class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1.5 group-hover:text-primary transition-colors duration-500"><%= spec[:key] %></span>
                      <span class="text-sm font-black text-slate-900 tracking-tight leading-none"><%= spec[:value] %></span>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-white border border-slate-100 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 translate-x-2 group-hover:translate-x-0">
                      <svg class="w-3.5 h-3.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4"></path></svg>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Technical Assurance & Add to Quote Action Block -->
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between py-6 px-6 bg-slate-50 border border-slate-100 rounded-lg relative overflow-hidden group shadow-sm">
            <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-5 transition-opacity duration-700"></div>
            <div class="flex items-center gap-5 relative z-10">
              <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center border border-slate-200 shadow-sm">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <p class="text-[11px] font-black text-slate-900 uppercase tracking-[0.25em] leading-none mb-2"><%= t('skus.technical_assurance') %></p>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"><%= t('skus.certified_factory_specifications') %></p>
              </div>
            </div>
            <div class="hidden md:flex items-center gap-3 relative z-10">
              <span class="px-3 py-1 bg-white text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] rounded-sm border border-slate-200 group-hover:border-primary/30 transition-colors">CE</span>
              <span class="px-3 py-1 bg-white text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] rounded-sm border border-slate-200 group-hover:border-primary/30 transition-colors">ROHS</span>
              <span class="px-3 py-1 bg-white text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] rounded-sm border border-slate-200 group-hover:border-primary/30 transition-colors">ISO</span>
            </div>
          </div>

          <button onclick="addToOrder(<%= @sku.id %>)" class="w-full inline-flex items-center justify-center px-8 py-5 bg-primary hover:bg-slate-900 text-white font-black text-[13px] tracking-[0.25em] uppercase transition-all duration-300 group shadow-xl shadow-primary/20 hover:shadow-slate-300 relative overflow-hidden rounded-sm">
            <span class="relative z-10"><%= t('skus.add_to_quote_request') %></span>
            <svg class="w-5 h-5 ml-4 group-hover:translate-x-1 transition-transform relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-10 transition-opacity"></div>
          </button>
        </div>
      </div>

      <!-- 操作区域已被移动至顶部 -->
      <div class="mt-8 pt-8 border-t border-slate-50">
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest"><%= t('skus.in_production') %></span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest"><%= t('skus.global_shipping') %></span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest"><%= t('skus.quality_warranty') %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 下方：详细特性 (工业风) -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl p-10 border border-slate-200 shadow-sm h-full">
        <div class="flex items-center justify-between mb-10 border-b border-slate-100 pb-6">
          <h3 class="text-lg font-black text-slate-900 tracking-[0.1em] uppercase"><%= t('skus.standard_features') %></h3>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest italic"><%= t('skus.technical_specifications') %></span>
        </div>
        <div class="prose prose-slate max-w-none text-slate-600 font-medium">
          <% if @sku.localized_standard_features.present? %>
            <%= @sku.localized_standard_features %>
          <% else %>
            <p class="italic text-slate-400"><%= t('skus.default_feature_desc') %></p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="lg:col-span-1">
      <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm h-full flex flex-col bg-white">
        <!-- Technical Contact Header -->
        <div class="bg-slate-900 p-8 text-center relative overflow-hidden">
          <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(30deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(150deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(30deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(150deg, #444 12%, transparent 12.5%, transparent 87%, #444 87.5%, #444), linear-gradient(60deg, #999 25%, transparent 25.5%, transparent 75%, #999 75%, #999), linear-gradient(60deg, #999 25%, transparent 25.5%, transparent 75%, #999 75%, #999); background-size: 40px 70px;"></div>
          <h3 class="text-white font-black text-lg relative z-10 tracking-widest uppercase mb-1"><%= t('skus.global_support') %></h3>
          <p class="text-primary text-[10px] font-black uppercase tracking-[0.3em] relative z-10"><%= t('skus.sales_engineering') %></p>
        </div>
        <!-- Contact body -->
        <div class="p-8 flex flex-col gap-6">
          <p class="text-slate-500 text-xs font-bold leading-relaxed uppercase tracking-wide"><%= t('skus.direct_channel_notice') %></p>
          
          <div class="space-y-4">
            <a href="https://wa.me/+8605438171612" target="_blank" class="flex items-center gap-4 p-4 border border-slate-100 hover:border-primary/30 transition-all group">
              <div class="w-10 h-10 bg-slate-50 flex items-center justify-center text-slate-400 group-hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest"><%= t('skus.whatsapp_business') %></p>
                <p class="text-xs font-black text-slate-900">+86 186 6303 1612</p>
              </div>
            </a>
            
            <a href="mailto:info@skyrainbow.com.cn" class="flex items-center gap-4 p-4 border border-slate-100 hover:border-primary/30 transition-all group">
              <div class="w-10 h-10 bg-slate-50 flex items-center justify-center text-slate-400 group-hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest"><%= t('skus.global_inquiry') %></p>
                <p class="text-xs font-black text-slate-900">info@skyrainbow.com.cn</p>
              </div>
            </a>
          </div>

          <%= link_to contact_path, class: "mt-4 block w-full text-center py-4 bg-primary text-white font-black text-[10px] tracking-[0.2em] uppercase transition-all shadow-lg shadow-primary/20 hover:scale-[1.02]" do %>
            <%= t('skus.request_factory_quote') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- 推荐产品 (工业风) -->
  <%
    all_in_cat = @sku.category.skus.where(status: 'active').order(position: :asc, created_at: :desc).to_a
    cur_idx    = all_in_cat.index { |s| s.id == @sku.id }
    related    = []
    if cur_idx
      # 获取前后各几个
      related << all_in_cat[cur_idx - 1] if cur_idx > 0
      related << all_in_cat[cur_idx + 1] if cur_idx + 1 < all_in_cat.length
      related << all_in_cat[cur_idx + 2] if cur_idx + 2 < all_in_cat.length
      # 如果不够 3 个，尝试从头部补
      if related.length < 3
        all_in_cat.each do |s|
          next if s.id == @sku.id || related.include?(s)
          related << s
          break if related.length >= 4
        end
      end
    end
    related.compact!
  %>
  <% if related.any? %>
    <div class="mt-20">
      <div class="flex items-center justify-between mb-10 border-b border-slate-100 pb-6">
        <h2 class="text-xl font-black text-slate-900 tracking-widest uppercase"><%= t('skus.related_equipment') %></h2>
        <div class="flex space-x-1">
          <div class="w-12 h-1 bg-primary"></div>
          <div class="w-4 h-1 bg-slate-200"></div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% related.take(4).each do |s| %>
          <%= link_to sku_path(s), class: "group bg-white border border-slate-200 hover:border-primary transition-all duration-300 flex flex-col h-full" do %>
            <div class="aspect-square overflow-hidden bg-slate-50 border-b border-slate-100">
              <% if s.images.attached? %>
                <% begin %>
                  <%= image_tag s.sorted_images.first.variant(resize_to_limit: [600, 600]),
                                class: "w-full h-full object-contain p-6 group-hover:scale-110 transition-transform duration-500" %>
                <% rescue %>
                  <div class="w-full h-full flex items-center justify-center text-slate-200"><%= t('skus.no_image') %></div>
                <% end %>
              <% end %>
            </div>
            <div class="p-6 bg-white">
              <p class="text-[8px] font-black text-primary uppercase tracking-[0.2em] mb-2"><%= s.category.localized_name %></p>
              <h3 class="font-black text-slate-900 text-xs leading-tight uppercase group-hover:text-primary transition-colors line-clamp-2"><%= s.localized_name %></h3>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
